NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
TWELVE_DATA_API_KEY=
SEC_USER_AGENT=AURYN contact@example.com
OPENAI_API_KEY=
OPENAI_MODEL=
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_API_SECRET=
# AI is off until an authenticated usage budget and model are configured.
AURYN_AI_ENABLED=false

# Localhost-only fixture preview, never enable for a commercial deployment.
AURYN_ENABLE_PREVIEW=false
# Comma-separated trusted administrator UUIDs, optional.
AURYN_ADMIN_USER_IDS=

# Optional existing provider; adds profile, earnings and insider coverage.
FINNHUB_API_KEY=
# Server-only; never prefix with NEXT_PUBLIC. Needed for durable jobs and paper plans.
SUPABASE_SERVICE_ROLE_KEY=
AURYN_PAPER_OWNER_ID=
AURYN_PAPER_EXECUTION_ENABLED=false
AURYN_PAPER_SCHEDULE_ENABLED=false
AURYN_ALERT_JOB_USER_ID=
CRON_SECRET=

# Set true before multi-user commercial deployment.
AURYN_REQUIRE_DISTRIBUTED_BUDGET=false
