            {fresh:!!warm?.contextTs&&Date.now()-warm.contextTs<5*60*1000,run:()=>fetchJson(`/api/context/${encodeURIComponent(symbol)}`,evidenceController.signal).then(x=>{if(live){setContext(x);mergeEvidenceWarm(symbol,{context:x})}})}
          ];
