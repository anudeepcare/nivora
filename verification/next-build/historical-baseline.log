     const {quotes,loading:quotesLoading,refreshing:quotesRefreshing,error:quoteError,lastCheckedAt,now,refresh:refreshQuotes}=usePortfolioQuotes(quoteRequests,rows.length>0);
     const coverage=useMemo(()=>quoteCoverage(rows,quotes,now),[rows,quotes,now]);
     const summary=useMemo(()=>valuationSummary(rows,quotes),[rows,quotes]);
     const assets=useMemo(()=>rows.flatMap<any>(x=>{const value=positionValue(x,quotes[x.symbol]?.market);if(value==null)return [];return x.asset_type==='CASH'?[{assetType:'CASH' as const,currency:'USD',amount:value}]:[{assetType:x.asset_type,symbol:x.symbol,quantity:Number(x.shares),price:quotes[x.symbol].market.displayPrice,avgCost:Number(x.avg_cost),thesisScore:currentResearch(quotes[x.symbol]?.research).thesisScore,action:currentResearch(quotes[x.symbol]?.research).ownerAction||undefined}]}),[rows,quotes]);
     const pulse=useMemo(()=>calculatePortfolioPulse(assets),[assets]);
     const capitalActions=useMemo(()=>{
      if(summary.missing)return [];
      const positions=rows.map(x=>({symbol:x.symbol,value:positionValue(x,quotes[x.symbol]?.market)??0,assetType:x.asset_type,archetype:currentResearch(quotes[x.symbol]?.research).archetype,rawAction:currentResearch(quotes[x.symbol]?.research).ownerAction}));
      const risk=analyzePortfolioRisk(positions.filter(x=>x.assetType!=='CASH').map(x=>({symbol:x.symbol,marketValue:x.value,archetype:x.archetype})));
      return buildPortfolioCioActions({positions,portfolioRisk:risk}).filter(x=>quotes[x.symbol]?.research?.state==='READY');
     },[rows,quotes,summary.missing]);
    
     const points=history.filter(x=>Number.isFinite(Number(x.totalValue))&&Number.isFinite(Date.parse(x.asOf))&&(range==='ALL'||Date.parse(x.asOf)>=Date.now()-Number(range)*86400000)).sort((a,b)=>Date.parse(a.asOf)-Date.parse(b.asOf));
     const values=points.map(x=>Number(x.totalValue)),min=Math.min(...values),max=Math.max(...values),firstTime=points.length?Date.parse(points[0].asOf):0,lastTime=points.length?Date.parse(points[points.length-1].asOf):0,line=points.map(x=>`${(Date.parse(x.asOf)-firstTime)/(lastTime-firstTime||1)*700},${160-(Number(x.totalValue)-min)/(max-min||1)*130}`).join(' ');
     async function save(e:React.FormEvent){e.preventDefault();if(busy)return;setError('');const symbol=draft.symbol.trim().toUpperCase();if(!/^[A-Z0-9][A-Z0-9./-]{0,19}$/.test(symbol)||!validPosition(draft.shares,draft.asset_type==='CASH'?1:draft.avg_cost)){setError('Enter a valid symbol, positive quantity and nonnegative average cost.');return}if(draft.asset_type==='CASH'&&symbol!=='USD'){setError('Cash tracking currently supports USD only; foreign currency needs verified FX valuation.');return}setBusy(true);try{const s=supabaseBrowser();const{data:{user},error}=await s.auth.getUser();if(error)throw error;if(!user)throw Error('Please sign in again.');const normalized=normalizeQuoteSymbol(symbol,draft.asset_type);let payload:any={user_id:user.id,symbol:normalized,asset_type:draft.asset_type,shares:Number(draft.shares),avg_cost:draft.asset_type==='CASH'?1:Number(draft.avg_cost),horizon:draft.horizon,currency:'USD',updated_at:new Date().toISOString()};let id=draft.id;if(!id){const {data:matches,error:readError}=await s.from('portfolio_positions').select('*').eq('user_id',user.id).eq('symbol',normalized);if(readError)throw readError;const existing=(matches||[]).filter(x=>(x.asset_type||'EQUITY')===draft.asset_type);if(existing.length>1)throw Error('Multiple existing lots found. Edit a specific lot to preserve its data.');if(existing.length===1){id=existing[0].id;const merged=mergePositionMath({shares:Number(existing[0].shares),avgCost:Number(existing[0].avg_cost)},{shares:payload.shares,avgCost:payload.avg_cost});payload={...payload,shares:merged.shares,avg_cost:merged.avgCost}}}const result=id?await s.from('portfolio_positions').update(payload).eq('id',id).eq('user_id',user.id):await s.from('portfolio_positions').insert(payload);if(result.error)throw result.error;setForm(false);setDraft(empty);setNotice('Position saved.');await load()}catch(e:any){setError(e.message)}finally{setBusy(false)}}
     async function recordBalance(){if(busy||summary.missing||!rows.length)return;setBusy(true);setError('');try{const s=supabaseBrowser();const {data:{session},error}=await s.auth.getSession();if(error)throw error;if(!session)throw Error('Please sign in again.');const r=await fetch('/api/portfolio/pulse',{method:'POST',headers:{'Content-Type':'application/json',Authorization:`Bearer ${session.access_token}`},body:JSON.stringify({totalValue:summary.knownValue,holdings:rows.map(x=>({symbol:x.symbol,assetType:x.asset_type,value:positionValue(x,quotes[x.symbol]?.market)}))})});const j=await r.json();if(!r.ok)throw Error(j.error||'Unable to record balance.');await load();setNotice('Current balance recorded. A new recording replaces today’s earlier snapshot.')}catch(e:any){setError(e.message)}finally{setBusy(false)}}
     async function remove(row:any){if(!window.confirm(`Remove ${row.symbol} from your portfolio?`))return;setBusy(true);try{const{error}=await supabaseBrowser().from('portfolio_positions').delete().eq('id',row.id);if(error)throw error;await load();setNotice('Position removed.')}catch(e:any){setError(e.message)}finally{setBusy(false)}}
     return <section className="pmPage pmPortfolioPage"><header className="pmHead"><div><span className="pmEyebrow">YOUR INVESTMENT PICTURE</span><h1>Portfolio</h1><p>Your capital, holdings and evidence in one place.</p></div><div className="pmActions"><button className="pmSecondary" onClick={()=>Promise.all([load(),refreshQuotes()])} disabled={loading||busy||quotesRefreshing} aria-label="Refresh portfolio" title="Refresh holdings and check prices; price requests are limited to once a minute"><RefreshCw size={16}/></button><button className="pmPrimary" onClick={()=>{setDraft(empty);setForm(!form)}}><Plus size={17}/> Add investment</button></div></header>
     {error&&<div className="pmMessage" role="alert">{error}</div>}{notice&&<div className="pmNotice" role="status">{notice}</div>}
     {form&&<section className="pmCard"><h2>{draft.id?'Edit position':'Add investment'}</h2><form onSubmit={save} className="pmForm"><label>Asset type<select value={draft.asset_type} disabled={!!draft.id} onChange={e=>setDraft({...draft,asset_type:e.target.value})}><option value="EQUITY">Stock</option><option value="CRYPTO">Crypto</option><option value="CASH">Cash (USD)</option></select></label><label>{draft.asset_type==='CASH'?'Currency':'Symbol'}<input required value={draft.symbol} disabled={!!draft.id} placeholder={draft.asset_type==='CASH'?'USD':'AAPL'} onChange={e=>setDraft({...draft,symbol:e.target.value})}/></label><label>{draft.asset_type==='CASH'?'Amount':'Quantity'}<input required type="number" min="0.00000001" step="any" value={draft.shares} onChange={e=>setDraft({...draft,shares:e.target.value})}/></label>{draft.asset_type!=='CASH'&&<label>Average cost ($)<input required type="number" min="0" step="any" value={draft.avg_cost} onChange={e=>setDraft({...draft,avg_cost:e.target.value})}/></label>}<label>Horizon<select value={draft.horizon} onChange={e=>setDraft({...draft,horizon:e.target.value})}><option value="long">Long term</option><option value="swing">Swing</option><option value="short">Short term</option></select></label><div className="pmActions"><button disabled={busy} className="pmPrimary">{busy?'Saving…':'Save position'}</button><button type="button" className="pmSecondary" onClick={()=>setForm(false)}>Cancel</button></div></form></section>}
     <nav className="pmTabs" aria-label="Portfolio views">{['Overview','Holdings','Allocation'].map(x=><button key={x} aria-current={tab===x?'page':undefined} onClick={()=>setTab(x)}>{x}</button>)}</nav>
     {loading?<div className="pmEmpty" role="status">Loading your portfolio…</div>:!rows.length?<div className="pmCard pmEmpty"><Wallet size={34}/><h2>Your portfolio starts here</h2><p>Add stocks, crypto or USD cash to see your allocation and holdings.</p><button className="pmPrimary" onClick={()=>setForm(true)}>Add your first investment</button></div>:<>
     <div className="pmStats"><article className="pmStat pmNavy"><span>{summary.missing?'Known portfolio value':'Total portfolio value'} <MetricHelp term="marketValue"/></span><strong>{money(summary.missing===rows.length?null:summary.knownValue)}</strong><small>{summary.missing?`${summary.missing} unpriced position(s) excluded`:`${rows.length} positions · USD`}</small></article><article className="pmStat"><span>Unrealized gain / loss <MetricHelp term="unrealizedPnl"/></span><strong className={summary.unrealized==null?'':summary.unrealized>=0?'pmPositive':'pmNegative'}>{money(summary.unrealized)}</strong><small>{coverage.total===0?'Not applicable to cash':summary.unrealized==null?'Awaiting price and recorded cost':summary.missing?'Priced positions with recorded cost':'Market value less recorded cost'} · not today’s return</small></article><article className="pmStat"><span>Cash balance</span><strong>{money(pulse.cashValue)}</strong><small>Recorded USD cash · not broker buying power</small></article></div>
     {coverage.total>0&&<div className="pmQuoteCoverage" role="status"><span><i data-status={coverage.missing?'missing':coverage.stale?'stale':'current'}/>{quotesLoading?'Pricing your holdings…':`${coverage.priced} of ${coverage.total} investments priced`}</span><span>{coverage.current} current{coverage.stale>0?` · ${coverage.stale} stale or unverified`:''}{coverage.missing>0?` · ${coverage.missing} unavailable`:''}</span><small>{quotesRefreshing?'Checking prices…':lastCheckedAt?`Checked ${new Date(lastCheckedAt).toLocaleTimeString(undefined,{hour:'2-digit',minute:'2-digit'})}`:'Awaiting first price check'}</small></div>}
     {quoteError&&<div className="pmNotice" role="status">{quoteError}</div>}
     {(tab==='Overview'||tab==='Allocation')&&<section className="pmCard pmAllocationCard"><div className="pmCardHead"><div><h2>Allocation <MetricHelp term="allocation" title="Portfolio allocation" body="Each percentage divides the recorded market value of an asset class by the known portfolio value, including USD cash. Positions with unavailable prices are excluded, so partial coverage can change these weights."/></h2><p>{summary.missing?'Priced holdings only':'Share of recorded portfolio value'} · {rows.length-summary.missing} of {rows.length} positions valued</p></div><span>{money(summary.missing===rows.length?null:summary.knownValue)}</span></div><div className="pmAllocationTrack" role="img" aria-label={summary.knownValue?Object.entries(pulse.assetAllocation).map(([key,value])=>`${key} ${(value/summary.knownValue*100).toFixed(1)} percent`).join(', '):'Allocation unavailable until positions are priced'}>{Object.entries(pulse.assetAllocation).map(([key,value],i)=><span key={key} style={{width:`${summary.knownValue?value/summary.knownValue*100:0}%`,background:['#2563eb','#6d92eb','#8ca3c3'][i]}}/>)}</div><div className="pmAllocationLegend">{Object.entries(pulse.assetAllocation).map(([key,value],i)=><div key={key}><span><i style={{background:['#2563eb','#6d92eb','#8ca3c3'][i]}}/>{key==='EQUITY'?'Stocks':key==='CRYPTO'?'Crypto':'Cash'}</span><strong>{summary.knownValue?`${(value/summary.knownValue*100).toFixed(1)}%`:'—'}</strong><small>{summary.knownValue?money(value):'Awaiting values'}</small></div>)}</div></section>}
     {(tab==='Overview'||tab==='Holdings')&&<HoldingsTable rows={rows} quotes={quotes} now={now} busy={busy} onEdit={row=>{setDraft(row);setForm(true);window.scrollTo({top:0,behavior:'smooth'})}} onRemove={remove}/>}
     {tab==='Overview'&&<details className="pmCard pmPortfolioReview"><summary><div><h2>Balance & portfolio context</h2><span>Recorded history, concentration and research coverage</span></div><ChevronDown size={18}/></summary><div className="pmOverview"><section className="pmCard"><div className="pmCardHead"><div><h2>Portfolio balance</h2><p>Recorded value over time</p></div><div className="pmRanges">{[['30','1M'],['90','3M'],['365','1Y'],['ALL','All']].map(([v,l])=><button key={v} aria-pressed={range===v} onClick={()=>setRange(v)}>{l}</button>)}</div></div>{points.length>=2?<><svg className="pmChart" viewBox="0 0 700 200" role="img" aria-label={`Balance history from ${money(values[0])} to ${money(values[values.length-1])}`}>{[30,95,160].map(y=><line key={y} x1="0" x2="700" y1={y} y2={y} stroke="currentColor" opacity=".08"/>)}<polyline points={line} fill="none" stroke="#3477ff" strokeWidth="3"/></svg><div className="pmChartDates"><span>{new Date(points[0].asOf).toLocaleDateString()}</span><span>{new Date(points[points.length-1].asOf).toLocaleDateString()}</span></div></>:<div className="pmEmpty"><ChartPie size={28}/><p>Not enough recorded snapshots for this period.</p></div>}<button className="pmSecondary" disabled={busy||summary.missing>0} onClick={recordBalance}>{busy?'Recording…':'Record current balance'}</button><p className="pmFootnote">Balance includes deposits, withdrawals and position edits. It is not a cash-flow-adjusted investment return. Historical snapshot pricing has not been revalidated.</p></section><section className="pmCard"><h2>Portfolio perspective</h2><div className="pmInsight"><span>Largest invested position</span><strong>{pulse.investedValue>0?`${pulse.largestPositionPct.toFixed(1)}%`:'—'}</strong><p>Of priced invested capital. Concentration can amplify both gains and losses.</p></div><div className="pmInsight"><span>Evidence coverage</span><strong>{pulse.scorableHoldings} scored equities</strong><p>Open a holding for its long-term thesis, independent valuation and tactical context.</p></div></section></div></details>}
     {tab==='Overview'&&<details className="pmCard pmCapitalPriorities"><summary><div><h2>Capital priorities</h2><span>{capitalActions.length ? `${capitalActions.length} portfolio considerations` : 'Sizing and concentration context'}</span></div><ChevronDown size={18}/></summary><p className="pmFootnote">Portfolio sizing constraints preserve the independent company call. Based on priced holdings and available business classifications; return correlation is not assessed in this view.</p>{capitalActions.length?<div className="pmHoldings">{capitalActions.map(action=><article className="pmHolding" key={action.symbol}><div><Link href={`/stock/${encodeURIComponent(action.symbol)}`}>{action.symbol}</Link><p>{action.reason}</p></div><div><small>Company call</small><b>{action.companyAction.replaceAll('_',' ')}</b></div><div><small>Portfolio action</small><b>{action.portfolioAction.replaceAll('_',' ')}</b></div><div><small>New capital cap</small><b>{action.maxNewPositionPct}%</b></div></article>)}</div>:<p>{summary.missing?'Complete market values are required before sizing priorities can be calculated.':'Refresh holding research to calculate current capital priorities.'}</p>}</details>}
    
    
     </>}
     </section>
    }
    export default function Page(){return <AuthGuard><AppShell><Content/></AppShell></AuthGuard>}
    
