       <article><small>TODAY P/L</small><b className={todayPnl<0?"bad":"good"}>{todayPnl>=0?"+":"-"}{money(todayPnl)}</b></article><article><small>TOTAL P/L</small><b className={totalPnl<0?"bad":"good"}>{totalPnl>=0?"+":"-"}{money(totalPnl)}</b></article><article><small>INVESTED</small><b>{money(invested)}</b></article><article><small>CASH</small><b>{money(cash)}</b><span>{cashPct.toFixed(1)}%</span></article><article><small>POSITIONS</small><b>{positions}</b></article><article className="health" onClick={()=>setHealthOpen(v=>!v)}><small>HEALTH</small><b>{health}/100</b><span>{pulse?.health?.label||"Current"} · details</span></article>
