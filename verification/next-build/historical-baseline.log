    [data-text-size="compact"] :where(.aurynSupportText,.aurynSecondaryText,.aurynHelperText,.aurynProductFooter p,.aurynProductFooter a,.aurynProductFooter span,.aurynProductFooter small,.aurynThemeNote){font-size:94%!important}
