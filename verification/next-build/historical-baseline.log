      onOpenCatalysts?:()=>void; onOpenRisks?:()=>void; onOpenDetails?:()=>void; onOpenThesis?:()=>void; onOpenValuation?:()=>void;
      onAddWatchlist?:()=>void; onTrackPosition?:()=>void; watching?:boolean;
