    function TradingDiagnostics({data}:{data:any}){
     const runner=data?.runner,audit=data?.decisionAudit,learning=data?.learning,metrics=data?.metrics;
     const runs:any[]=Array.isArray(data?.recentRuns)?data.recentRuns:[];
