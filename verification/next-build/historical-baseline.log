    function mergeEvidenceWarm(symbol:string,patch:Partial<StockWarmCache>){
      stockWarmCache.merge(symbol,patch);
    }
    export default function StockClient({symbol}:{symbol:string}){
      const thesisRef=useRef<HTMLElement>(null);
