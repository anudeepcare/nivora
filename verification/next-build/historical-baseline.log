          <div className="researchChartStage" aria-busy={chartLoading}>{candles.length?<PriceChart candles={candles} levels={visibleChartLevels} showTrend={showMovingAverages}/>:<div className="researchEmpty researchChartEmpty" role="status"><strong>{chartLoading?"Loading market history…":"History unavailable"}</strong>{!chartLoading&&<><p>{chartError||"No price history was returned for this period."}</p>{onRetryChart&&<button type="button" onClick={onRetryChart}>Retry history</button>}</>}</div>}{chartLoading&&<span className="researchChartLoading" role="status">Updating history…</span>}</div>
          <footer className="surfaceChartFoot"><span>{chartRange} · {chartCoverage|| (candles.length?`${candles.length} observations`:"Awaiting history")}</span>{onOpenTechnicals&&<button type="button" onClick={onOpenTechnicals}>Fib & weekly <ArrowUpRight size={15}/></button>}</footer>
          <dialog ref={chartDialog} className="researchExpandedDialog" aria-label="Expanded price chart"><header><h2>{symbol} · {chartRange}</h2><form method="dialog"><button aria-label="Close expanded chart">Close</button></form></header><div className="researchExpandedChart"><PriceChart candles={candles} levels={visibleChartLevels} showTrend={showMovingAverages}/></div></dialog>
        </article>
    
