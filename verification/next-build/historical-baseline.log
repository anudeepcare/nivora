     .v383TechnicalStateGrid,.v34TechnicalScoreGrid{grid-template-columns:repeat(2,minmax(0,1fr))!important}.v383TechnicalStateGrid>*,.v34TechnicalScoreGrid>*{border-bottom:1px solid var(--auryn-border)!important}
