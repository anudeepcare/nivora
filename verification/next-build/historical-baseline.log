    .aurynPage{display:grid;gap:24px;min-width:0}.aurynPageHead{max-width:820px;padding:18px 0 8px}.aurynPageHead h1{font:600 clamp(38px,5vw,58px)/1.02 Georgia,serif;letter-spacing:-.045em;margin:9px 0 12px}.aurynPageHead p{margin:0;color:var(--auryn-muted);line-height:1.6}.aurynInlineForm{display:grid;grid-template-columns:minmax(120px,.55fr) minmax(150px,.75fr) auto;gap:10px;max-width:680px}.aurynInlineForm input{height:48px;min-width:0;border:1px solid var(--auryn-line);border-radius:10px;padding:0 12px;background:#fff;outline:0}.aurynInlineForm button{height:48px;border:0;border-radius:10px;padding:0 18px;background:var(--auryn-ink);color:#fff;font-weight:800}.aurynMonitorSummary{display:flex;align-items:center;gap:11px;padding:16px 0;border-top:1px solid var(--auryn-line);border-bottom:1px solid var(--auryn-line)}.aurynMonitorSummary span{display:block;color:var(--auryn-muted);font-size:12px;margin-top:2px}.aurynList{display:grid;border-top:1px solid var(--auryn-line)}.aurynAlertRow{display:grid;grid-template-columns:1fr auto auto;gap:14px;align-items:center;padding:15px 2px;border-bottom:1px solid var(--auryn-line)}.aurynAlertRow small{display:block;color:var(--auryn-subtle)}.aurynIconButton{width:38px;height:38px;border:1px solid var(--auryn-line);border-radius:9px;background:transparent;display:grid;place-items:center}
    @media(max-width:560px){.aurynInlineForm{grid-template-columns:1fr 1fr}.aurynInlineForm button{grid-column:1/-1}.aurynPageHead{padding-top:8px}}
    
    .aurynAddPanel{display:grid;gap:14px}.aurynAssetTabs{display:flex;gap:6px}.aurynAssetTabs button{display:flex;align-items:center;gap:6px;border:1px solid var(--auryn-line);background:transparent;border-radius:9px;padding:9px 11px}.aurynAssetTabs button.on{background:var(--auryn-ink);color:#fff;border-color:var(--auryn-ink)}.aurynAssetForm,.aurynEditForm{display:grid;grid-template-columns:repeat(4,minmax(0,1fr)) auto;gap:8px}.aurynAssetForm input,.aurynAssetForm select,.aurynEditForm input{min-width:0;height:44px;border:1px solid var(--auryn-line);border-radius:9px;padding:0 10px;background:#fff}.aurynAssetForm button,.aurynEditForm button{border:0;border-radius:9px;padding:0 14px;background:var(--auryn-ink);color:#fff;font-weight:750}.aurynPortfolioDetails{display:grid;grid-template-columns:1fr .8fr;gap:28px}.aurynAllocation{display:grid}.aurynAllocation>div{margin-bottom:10px}.aurynAllocation h2{margin:4px 0;font:600 25px Georgia,serif}.aurynAllocation article{display:grid;grid-template-columns:1fr auto auto;gap:16px;padding:12px 0;border-bottom:1px solid var(--auryn-line)}.aurynAllocation em{color:var(--auryn-muted);font-style:normal}.aurynRiskOverlay{align-self:start;padding:20px;border-left:2px solid var(--auryn-gold);display:grid;grid-template-columns:auto 1fr;gap:9px 12px}.aurynRiskOverlay small,.aurynRiskOverlay span{color:var(--auryn-muted);font-size:11px}.aurynRiskOverlay b{display:block;font:600 23px Georgia,serif;margin:3px 0}
    @media(max-width:900px){.aurynPortfolioDetails{grid-template-columns:1fr}.aurynAssetForm,.aurynEditForm{grid-template-columns:1fr 1fr}.aurynAssetForm button,.aurynEditForm button{min-height:44px}}@media(max-width:560px){.aurynAssetForm,.aurynEditForm{grid-template-columns:1fr}.aurynAssetTabs{overflow-x:auto}.aurynAssetTabs button{flex:0 0 auto}}
    
    /* AURYN V3 landing */
    .aurynLanding{min-height:100dvh;background:var(--auryn-canvas);color:var(--auryn-text)}
    .aurynLanding>header{height:76px;max-width:var(--auryn-content);margin:auto;padding:0 clamp(20px,4vw,64px);display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--auryn-line)}
    .aurynLanding>header>div{display:flex;align-items:center;gap:20px;font-size:13px;font-weight:750}
    .goldButton{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--auryn-gold);color:#17130e!important;border-radius:10px;padding:12px 16px;font-weight:850}
    .aurynHero{max-width:var(--auryn-content);margin:auto;min-height:650px;padding:clamp(64px,8vw,118px) clamp(20px,5vw,76px);display:grid;grid-template-columns:minmax(0,1.08fr) minmax(380px,.72fr);gap:clamp(50px,8vw,120px);align-items:center}
    .aurynHeroCopy{max-width:760px}.aurynKicker{display:flex;align-items:center;gap:8px;color:var(--auryn-gold-strong);font-size:11px;font-weight:850;letter-spacing:.17em}
    .aurynHero h1{margin:20px 0 24px;font:600 clamp(58px,7vw,102px)/.88 Georgia,serif;letter-spacing:-.065em}.aurynHero h1 em{color:var(--auryn-gold-strong);font-weight:400}
    .aurynHeroCopy>p{max-width:700px;color:var(--auryn-muted);font-size:clamp(16px,1.45vw,20px);line-height:1.65}
    .aurynHeroActions{display:flex;align-items:center;gap:24px;margin-top:32px;font-size:13px;font-weight:800}.aurynProof{display:flex;flex-wrap:wrap;gap:22px;margin-top:34px;padding-top:25px;border-top:1px solid var(--auryn-line);color:var(--auryn-muted);font-size:12px}.aurynProof span{display:flex;align-items:center;gap:7px}.aurynProof svg{width:16px;color:var(--auryn-gold-strong)}
    .aurynHeroPanel{background:var(--auryn-ink);color:#f7efe1;border-radius:var(--auryn-radius-lg);padding:clamp(28px,3vw,42px);box-shadow:var(--auryn-shadow)}.aurynHeroPanel>small{color:#9d9488;letter-spacing:.14em;font-size:9px}.aurynCall{display:grid;grid-template-columns:1fr auto;align-items:end;gap:3px 16px;margin:22px 0}.aurynCall span{font-size:10px;letter-spacing:.15em;color:#a59d91}.aurynCall b{grid-row:1/3;grid-column:2;font:600 clamp(40px,4vw,58px) Georgia,serif;color:#dfbc80}.aurynCall em{font-size:12px;color:#c2b8a8}.aurynHeroPanel>p{color:#c5bcad;line-height:1.55}
    .aurynMiniMetrics{display:grid;grid-template-columns:repeat(4,1fr);margin:26px 0;border-block:1px solid #39342d}.aurynMiniMetrics span{padding:16px 9px;border-right:1px solid #39342d}.aurynMiniMetrics span:last-child{border:0}.aurynMiniMetrics small{display:block;color:#918a80;font-size:8px;letter-spacing:.1em}.aurynMiniMetrics b{display:block;margin-top:5px;font-size:16px}.aurynWhy{display:grid;gap:8px;color:#c4bbad;font-size:12px}.aurynWhy b{color:#f4e9d8;margin-bottom:2px}
    .aurynLandingBand{background:var(--auryn-ink);color:#f5eddf;padding:48px max(20px,calc((100vw - var(--auryn-content))/2 + 64px))}.aurynLandingBand>small{color:#a99d8d;font-size:9px;letter-spacing:.16em}.aurynLandingBand>div{display:grid;grid-template-columns:repeat(4,1fr);margin-top:22px}.aurynLandingBand article{padding:10px 28px 10px 0;border-right:1px solid #37322b}.aurynLandingBand article+article{padding-left:28px}.aurynLandingBand article:last-child{border:0}.aurynLandingBand article>b{color:var(--auryn-gold);font-size:11px}.aurynLandingBand h2{font:600 28px Georgia,serif;margin:9px 0}.aurynLandingBand p{color:#aaa196;font-size:12px}
    .aurynLanding>footer{max-width:var(--auryn-content);margin:auto;padding:25px clamp(20px,4vw,64px);display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:24px;color:var(--auryn-muted);font-size:11px}.aurynLanding>footer>span{text-align:center}.aurynLanding>footer nav{display:flex;gap:15px}
    @media(max-width:900px){.aurynHero{grid-template-columns:1fr;min-height:0;padding-top:70px}.aurynHeroPanel{max-width:700px}.aurynLandingBand>div{grid-template-columns:1fr 1fr}.aurynLandingBand article:nth-child(2){border-right:0}.aurynLanding>footer{grid-template-columns:1fr;text-align:center}.aurynLanding>footer .aurynBrand,.aurynLanding>footer nav{justify-self:center}}
    @media(max-width:560px){.aurynLanding>header{height:66px}.aurynLanding>header .aurynBrand small{display:none}.aurynLanding>header>div>a:first-child{display:none}.aurynHero{padding:48px 18px 55px;gap:34px}.aurynHero h1{font-size:54px}.aurynHeroActions{align-items:flex-start;flex-direction:column;gap:16px}.aurynProof{display:grid}.aurynHeroPanel{padding:24px 20px}.aurynMiniMetrics{grid-template-columns:1fr 1fr}.aurynMiniMetrics span:nth-child(2){border-right:0}.aurynLandingBand{padding:38px 20px}.aurynLandingBand>div{grid-template-columns:1fr}.aurynLandingBand article,.aurynLandingBand article+article{padding:18px 0;border-right:0;border-bottom:1px solid #37322b}.aurynLanding>footer{padding-bottom:calc(24px + env(safe-area-inset-bottom))}}
    
    
    /* AURYN V3.3 — complete product chrome */
    .aurynProductFooter{width:100%;margin-top:28px;background:var(--auryn-ink);color:#d8d0c4;border-top:1px solid rgba(255,255,255,.07)}
    .aurynProductFooterInner{width:min(var(--auryn-content),100%);margin:auto;padding:42px clamp(20px,3vw,42px) 32px;display:grid;grid-template-columns:minmax(260px,1fr) auto;gap:60px}
    .aurynProductFooterBrand{max-width:540px}.aurynProductFooterBrand .aurynBrand{color:#f4ecde}.aurynProductFooterBrand p{margin:14px 0 0;max-width:500px;color:#8e877d;font-size:12px;line-height:1.6}
    .aurynProductFooter nav{display:grid;grid-template-columns:repeat(2,minmax(130px,1fr));gap:44px}.aurynProductFooter nav>div{display:grid;align-content:start;gap:9px}.aurynProductFooter nav small{margin-bottom:2px;color:#6f685f;font-size:9px;font-weight:850;letter-spacing:.15em}.aurynProductFooter nav a{color:#c9c0b4;font-size:12px}.aurynProductFooter nav a:hover{color:#f3e5cf}
    .aurynProductFooterBottom{width:min(var(--auryn-content),100%);margin:auto;padding:16px clamp(20px,3vw,42px) 20px;display:flex;justify-content:space-between;gap:24px;border-top:1px solid rgba(255,255,255,.07);color:#69635b;font-size:10px}
    .aurynAuthProductLinks{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 16px;margin-top:18px;padding-top:16px;border-top:1px solid #e7dfd3;color:var(--auryn-muted);font-size:10px}.aurynAuthProductLinks a:hover{color:var(--auryn-gold-strong)}
    
    /* Portfolio V3.3 */
    .aurynPortfolioPulse{display:grid;gap:0;min-width:0}
    .aurynPortfolioSummary{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(300px,.55fr);background:var(--auryn-ink);color:#f6eee1;border-radius:22px;overflow:hidden}
    .aurynPortfolioLead{padding:34px 36px}.aurynPortfolioLead>small,.aurynPortfolioCondition>small{color:#9b9285;font-size:9px;letter-spacing:.14em;font-weight:800}.aurynPortfolioLead h1{margin:12px 0 8px;font:600 clamp(44px,5vw,68px)/.95 Georgia,serif;letter-spacing:-.045em}.aurynPnl{font-size:18px;font-weight:800}.aurynPnl span{color:#91897e;font-size:12px;font-weight:500}.aurynPortfolioLead p{max-width:720px;margin:24px 0 0;color:#b6aea2;font-size:13px;line-height:1.6}
    .aurynPortfolioCondition{padding:32px;border-left:1px solid rgba(255,255,255,.10);display:grid;align-content:center}.aurynPortfolioCondition strong{font:600 52px Georgia,serif;color:var(--auryn-gold-soft);line-height:1}.aurynPortfolioCondition>span{color:#948c81;font-size:13px}.aurynPortfolioCondition i{height:4px;margin:16px 0 12px;background:linear-gradient(90deg,var(--auryn-gold) var(--score),#37322b var(--score));border-radius:99px}.aurynPortfolioCondition em{color:#aca397;font-size:11px;font-style:normal}
    .aurynPortfolioPeriods{display:flex;gap:3px;overflow-x:auto;padding:16px 0 14px;scrollbar-width:none}.aurynPortfolioPeriods::-webkit-scrollbar{display:none}.aurynPortfolioPeriods button{flex:0 0 auto;border:0;background:transparent;color:var(--auryn-muted);padding:9px 11px;border-radius:9px;font-size:11px;font-weight:750}.aurynPortfolioPeriods button.on{background:#2c2822;color:#f3e6d1}
    .aurynPortfolioMetrics{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));border:1px solid var(--auryn-line);border-radius:16px;overflow:hidden;background:rgba(255,255,255,.34)}
    .aurynPortfolioMetrics article{min-width:0;padding:17px 18px;border-right:1px solid var(--auryn-line)}.aurynPortfolioMetrics article:last-child{border-right:0}.aurynPortfolioMetrics small{display:block;color:var(--auryn-subtle);font-size:9px;letter-spacing:.1em}.aurynPortfolioMetrics b{display:block;margin:5px 0 3px;font:600 20px Georgia,serif}.aurynPortfolioMetrics span{display:block;color:var(--auryn-muted);font-size:10px;line-height:1.4}
    .aurynCapitalPriorities{padding:32px 0}.aurynCapitalPriorities>header,.aurynPortfolioSectionHead{display:flex;justify-content:space-between;gap:20px;align-items:flex-end;margin-bottom:16px}.aurynCapitalPriorities>header small,.aurynPortfolioSectionHead small{color:var(--auryn-gold-strong);font-size:9px;letter-spacing:.14em;font-weight:850}.aurynCapitalPriorities>header h2,.aurynPortfolioSectionHead h2{margin:6px 0 0;font:600 30px Georgia,serif}.aurynCapitalPriorities>header>span,.aurynPortfolioSectionHead>span{color:var(--auryn-subtle);font-size:10px}
    .aurynCapitalPriorities>div{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.aurynCapitalBucket{min-width:0;border:1px solid var(--auryn-line);border-radius:15px;background:rgba(255,255,255,.38);overflow:hidden}.aurynCapitalBucket>header{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:8px;padding:14px 15px;border-bottom:1px solid var(--auryn-line)}.aurynCapitalBucket>header i{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:#efe5d4;color:var(--auryn-gold-strong)}.aurynCapitalBucket>header i svg{width:14px}.aurynCapitalBucket>header small{font-weight:850;letter-spacing:.08em}.aurynCapitalBucket>header>b{font-size:11px;color:var(--auryn-muted)}.aurynCapitalBucket>div{display:grid}.aurynCapitalBucket>div>span{display:grid;grid-template-columns:auto auto 1fr;gap:7px;align-items:baseline;padding:12px 15px;border-bottom:1px solid var(--auryn-line)}.aurynCapitalBucket>div>span:last-child{border-bottom:0}.aurynCapitalBucket>div b{font-size:12px}.aurynCapitalBucket>div em{font-style:normal;color:var(--auryn-gold-strong);font-size:10px;font-weight:800}.aurynCapitalBucket>div small{grid-column:1/-1;color:var(--auryn-muted);font-size:10px;line-height:1.45}.aurynCapitalBucket>p{margin:0;padding:20px 15px;color:var(--auryn-muted);font-size:12px}
    .aurynPortfolioVisuals{padding:28px 0;border-top:1px solid var(--auryn-line);border-bottom:1px solid var(--auryn-line)}
    .aurynVisualModes{display:flex;gap:5px;overflow-x:auto;margin-bottom:22px}.aurynVisualModes button{flex:0 0 auto;border:1px solid var(--auryn-line);background:transparent;border-radius:10px;padding:9px 13px;font-size:11px;font-weight:750}.aurynVisualModes button.on{background:var(--auryn-ink);border-color:var(--auryn-ink);color:#fff}.aurynVisualModes button:disabled{opacity:.4}
    .aurynCompactUnavailable{padding:20px;border:1px dashed var(--auryn-line);border-radius:12px;color:var(--auryn-muted)}.aurynCompactUnavailable b{display:block;color:var(--auryn-text);margin-bottom:5px}.aurynCompactUnavailable span{font-size:11px}
    .aurynDriverBars{display:grid;gap:13px}.aurynDriverBars>div{display:grid;grid-template-columns:64px minmax(0,1fr) 150px;gap:14px;align-items:center}.aurynDriverBars>div>b{font-size:12px}.aurynDriverBars>div>i{height:7px;border-radius:99px;background:#e8ede9;overflow:hidden}.aurynDriverBars>div>i>em{display:block;height:100%;border-radius:99px;background:var(--auryn-good)}.aurynDriverBars>div>i>em.neg{background:#cc5549}.aurynDriverBars>div>span{text-align:right;font-size:11px;font-weight:750}
    .aurynAllocationMap{display:flex;min-height:150px;gap:8px}.aurynAllocationMap article{min-width:120px;padding:18px;border-radius:12px;background:#ede4d5;display:grid;align-content:end}.aurynAllocationMap small{color:var(--auryn-muted)}.aurynAllocationMap b{font:600 28px Georgia,serif}
    .aurynRiskBars{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.aurynRiskBars article{padding:16px;border:1px solid var(--auryn-line);border-radius:12px}.aurynRiskBars small{display:block;color:var(--auryn-subtle);font-size:9px}.aurynRiskBars b{display:block;margin:5px 0 12px;font-size:20px}.aurynRiskBars i{display:block;height:5px;background:#e9e3d9;border-radius:99px;overflow:hidden}.aurynRiskBars em{display:block;height:100%;background:var(--auryn-gold);border-radius:99px}
    .aurynPortfolioEvidenceToggle{width:100%;margin:18px 0 0;padding:15px 16px;border:1px solid var(--auryn-line);border-radius:12px;background:transparent;display:flex;align-items:center;justify-content:space-between;text-align:left}.aurynPortfolioEvidenceToggle>span{display:grid;grid-template-columns:auto auto;gap:2px 9px;align-items:center}.aurynPortfolioEvidenceToggle svg{grid-row:1/3;width:17px}.aurynPortfolioEvidenceToggle b{font-size:12px}.aurynPortfolioEvidenceToggle small{color:var(--auryn-muted);font-size:10px}.aurynPortfolioEvidenceToggle>svg{transition:transform .2s}.aurynPortfolioEvidenceToggle>svg.open{transform:rotate(180deg)}.aurynPortfolioEvidenceDeep{display:grid;gap:14px;margin-top:14px}
    
    /* Stock evidence containment — isolates deeper legacy renderers inside the V3 product system */
    .aurynStockEvidenceSurface{min-width:0;padding:4px 0 18px}
    .aurynStockEvidenceSurface>.v65Evidence,.aurynStockEvidenceSurface>.v12Fund,.aurynStockEvidenceSurface>.v34InstitutionsPage,.aurynStockEvidenceSurface>.v12Technical,.aurynStockEvidenceSurface>.v26Technical,.aurynStockEvidenceSurface>.gammaPanel,.aurynStockEvidenceSurface>.v12News,.aurynStockEvidenceSurface>.v12Earnings{min-width:0;max-width:100%;background:transparent;border:0;border-radius:0;box-shadow:none}
    .aurynStockEvidenceSurface .v65EvidenceHero,.aurynStockEvidenceSurface .v65EvidenceState,.aurynStockEvidenceSurface .v65EvidenceMetrics,.aurynStockEvidenceSurface .v34IndicatorGrid,.aurynStockEvidenceSurface .proTechGrid,.aurynStockEvidenceSurface .earnGrid,.aurynStockEvidenceSurface .optionsQuick{border-color:var(--auryn-line);background:rgba(255,255,255,.32)}
    .aurynStockEvidenceSurface .v65EvidenceHero{border-radius:16px;overflow:hidden}
    .aurynStockEvidenceSurface h2,.aurynStockEvidenceSurface h3,.aurynStockEvidenceSurface h4{color:var(--auryn-text)}
    .aurynStockEvidenceSurface p,.aurynStockEvidenceSurface span{max-width:100%}
    .aurynStockEvidenceSurface button{font-family:inherit}
    
    /* Legal pages */
    .legalPage,.aurynAboutPage{width:min(960px,calc(100% - 32px));margin:0 auto;padding:28px 0 72px;color:var(--auryn-text)}
    .legalTop{height:64px;display:flex;align-items:center;justify-content:space-between;margin-bottom:32px;border-bottom:1px solid var(--auryn-line)}.legalBack{display:inline-flex;align-items:center;gap:7px;border:0;background:transparent;color:var(--auryn-muted);font-weight:750}
    .legalPage>small,.aurynAboutPage>small{color:var(--auryn-gold-strong);font-size:10px;font-weight:850;letter-spacing:.15em}.legalPage h1,.aurynAboutPage>h1{font:600 clamp(40px,6vw,62px)/1 Georgia,serif;letter-spacing:-.045em;margin:12px 0 26px}.legalPage h2,.aurynAboutPage h2{font:600 27px Georgia,serif;margin:34px 0 10px}.legalPage p,.aurynAboutPage p{color:var(--auryn-muted);line-height:1.72;font-size:14px}.legalPage b{color:var(--auryn-text)}.legalLinks{display:flex;flex-wrap:wrap;gap:14px;margin-top:32px;padding-top:20px;border-top:1px solid var(--auryn-line)}.legalLinks a{color:var(--auryn-gold-strong);font-weight:800;font-size:12px}
    
    @media(max-width:900px){
     .aurynProductFooterInner{grid-template-columns:1fr;gap:30px}.aurynProductFooter nav{justify-self:start}
     .aurynPortfolioSummary{grid-template-columns:1fr}.aurynPortfolioCondition{border-left:0;border-top:1px solid rgba(255,255,255,.10)}
     .aurynPortfolioMetrics{grid-template-columns:repeat(3,1fr)}.aurynPortfolioMetrics article:nth-child(3){border-right:0}.aurynPortfolioMetrics article:nth-child(-n+3){border-bottom:1px solid var(--auryn-line)}
     .aurynCapitalPriorities>div{grid-template-columns:1fr}.aurynRiskBars{grid-template-columns:1fr}
     .aurynProductFooter{padding-bottom:calc(var(--mobile-nav-height) + env(safe-area-inset-bottom))}
    }
    @media(max-width:560px){
     .aurynProductFooterInner{padding:32px 18px 24px}.aurynProductFooter nav{grid-template-columns:1fr 1fr;gap:24px;width:100%}.aurynProductFooterBottom{padding:14px 18px 18px;display:grid;gap:6px}
     .aurynPortfolioLead{padding:26px 20px}.aurynPortfolioCondition{padding:24px 20px}.aurynPortfolioMetrics{grid-template-columns:1fr 1fr}.aurynPortfolioMetrics article{border-bottom:1px solid var(--auryn-line)}.aurynPortfolioMetrics article:nth-child(odd){border-right:1px solid var(--auryn-line)}.aurynPortfolioMetrics article:nth-child(even){border-right:0}.aurynPortfolioMetrics article:nth-last-child(-n+2){border-bottom:0}
     .aurynCapitalPriorities>header,.aurynPortfolioSectionHead{align-items:flex-start;flex-direction:column;gap:4px}.aurynCapitalBucket>div>span{grid-template-columns:auto 1fr}.aurynCapitalBucket>div em{text-align:right}
     .aurynDriverBars>div{grid-template-columns:52px minmax(0,1fr)}.aurynDriverBars>div>span{grid-column:2;text-align:left}.aurynAllocationMap{min-height:120px;overflow-x:auto}.aurynAllocationMap article{flex:0 0 140px!important}
     .legalPage,.aurynAboutPage{width:min(100% - 28px,960px);padding-bottom:48px}.legalTop{margin-bottom:24px}
    }
    
    
    /* Portfolio evidence depth */
    .aurynPortfolioHealth,.aurynPortfolioBrief,.aurynPortfolioXRay{padding:22px;border:1px solid var(--auryn-line);border-radius:15px;background:rgba(255,255,255,.38)}
    .aurynPortfolioHealth>header{display:grid;grid-template-columns:minmax(0,.7fr) minmax(0,1fr);gap:24px;align-items:end}.aurynPortfolioHealth>header small,.aurynPortfolioBrief>header small{color:var(--auryn-gold-strong);font-size:9px;letter-spacing:.12em}.aurynPortfolioHealth>header h2{margin:5px 0 0}.aurynPortfolioHealth>header h2 b{font:600 38px Georgia,serif}.aurynPortfolioHealth>header h2 span{color:var(--auryn-muted);font-size:12px;font-weight:500}.aurynPortfolioHealth>header p{margin:0;color:var(--auryn-muted);font-size:12px;line-height:1.5}
    .aurynHealthGrid,.aurynBriefGrid{display:grid;grid-template-columns:repeat(2,1fr);gap:0;margin-top:18px;border:1px solid var(--auryn-line);border-radius:12px;overflow:hidden}.aurynHealthGrid article,.aurynBriefGrid article{padding:16px;border-right:1px solid var(--auryn-line);border-bottom:1px solid var(--auryn-line)}.aurynHealthGrid article:nth-child(even),.aurynBriefGrid article:nth-child(even){border-right:0}.aurynHealthGrid article:nth-last-child(-n+2),.aurynBriefGrid article:nth-last-child(-n+2){border-bottom:0}.aurynHealthGrid small,.aurynBriefGrid small{display:block;color:var(--auryn-subtle);font-size:9px;text-transform:uppercase;letter-spacing:.08em}.aurynHealthGrid b,.aurynBriefGrid b{display:block;margin:7px 0;color:var(--auryn-text);font-size:12px;line-height:1.5}.aurynHealthGrid span{display:block;margin-top:4px;color:var(--auryn-muted);font-size:10px;line-height:1.45}.aurynPortfolioHealth>footer{margin-top:14px;color:var(--auryn-subtle);font-size:10px}
    .aurynPortfolioBrief>header h2{font:600 25px Georgia,serif;margin:5px 0 0}
    .aurynXRayModes{display:flex;gap:5px;overflow-x:auto;margin-bottom:16px}.aurynXRayModes button{flex:0 0 auto;border:1px solid var(--auryn-line);background:transparent;border-radius:9px;padding:8px 11px;font-size:10px;font-weight:750}.aurynXRayModes button.on{background:var(--auryn-ink);color:#fff}.aurynXRayRail{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:8px}.aurynXRayRail article{padding:14px;border:1px solid var(--auryn-line);border-radius:10px}.aurynXRayRail small{display:block;color:var(--auryn-subtle);font-size:9px}.aurynXRayRail b{display:block;margin:5px 0;font:600 22px Georgia,serif}.aurynXRayRail span,.aurynXRayQuiet{color:var(--auryn-muted);font-size:10px}
    .aurynPortfolioChart{min-width:0}.aurynChartToggles{display:flex;gap:6px;margin-bottom:10px}.aurynChartToggles button{border:1px solid var(--auryn-line);background:transparent;border-radius:8px;padding:7px 10px;font-size:10px}.aurynChartToggles button.on{background:var(--auryn-ink);color:#fff}.aurynPortfolioChart svg{width:100%;height:240px;overflow:visible}.aurynPortfolioChart svg line{stroke:#cfc6b8;stroke-width:.35}.aurynPortfolioChart svg path{stroke-width:1.5}.aurynPortfolioChart svg .s0{stroke:#17130f}.aurynPortfolioChart svg .s1{stroke:#b78a49}.aurynPortfolioChart svg .s2{stroke:#6f8578}.aurynPortfolioChartAxis{display:flex;justify-content:space-between;color:var(--auryn-subtle);font-size:9px}.aurynPortfolioChartEmpty{padding:20px;border:1px dashed var(--auryn-line);border-radius:10px;color:var(--auryn-muted);font-size:11px}
    
    /* Stock Thesis / evidence adapter */
    .aurynStockEvidenceSurface .v65Thesis{display:grid;gap:14px}
    .aurynStockEvidenceSurface .v658VerdictSurface{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(250px,.55fr);border:1px solid var(--auryn-line);border-radius:18px;overflow:hidden;background:rgba(255,255,255,.36)}
    .aurynStockEvidenceSurface .v658VerdictLead{padding:26px}.aurynStockEvidenceSurface .v658VerdictLead>small,.aurynStockEvidenceSurface .v658VerdictAction>small{color:var(--auryn-gold-strong);font-size:9px;font-weight:850;letter-spacing:.13em}.aurynStockEvidenceSurface .v658VerdictHeadline{display:flex;align-items:center;gap:12px;margin:10px 0}.aurynStockEvidenceSurface .v658VerdictHeadline h3{margin:0;font:600 35px Georgia,serif}.aurynStockEvidenceSurface .v658VerdictHeadline span{padding:5px 8px;border-radius:8px;background:#eee7db;color:var(--auryn-muted);font-size:12px;font-weight:800}.aurynStockEvidenceSurface .v658VerdictLead>p{margin:0;color:var(--auryn-muted);line-height:1.55}
    .aurynStockEvidenceSurface .v658VerdictAction{padding:26px;border-left:1px solid var(--auryn-line);display:grid;align-content:center}.aurynStockEvidenceSurface .v658VerdictAction>b{margin:8px 0 2px;font:600 28px Georgia,serif}.aurynStockEvidenceSurface .v658VerdictAction>span{color:var(--auryn-muted);font-size:10px}.aurynStockEvidenceSurface .v658VerdictAction>p{color:var(--auryn-subtle);font-size:10px;line-height:1.45}
    .aurynStockEvidenceSurface .v658VerdictMetrics{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--auryn-line)}.aurynStockEvidenceSurface .v658VerdictMetrics article{padding:15px 18px;border-right:1px solid var(--auryn-line)}.aurynStockEvidenceSurface .v658VerdictMetrics article:last-child{border-right:0}.aurynStockEvidenceSurface .v658VerdictMetrics article>div{display:flex;justify-content:space-between;gap:10px}.aurynStockEvidenceSurface .v658VerdictMetrics small{font-size:8px;letter-spacing:.1em;color:var(--auryn-subtle)}.aurynStockEvidenceSurface .v658VerdictMetrics b{font-size:14px}.aurynStockEvidenceSurface .v658VerdictMetrics i,.aurynStockEvidenceSurface .v65FactorGrid i{display:block;height:4px;margin:10px 0 7px;background:#e7e2d9;border-radius:99px;overflow:hidden}.aurynStockEvidenceSurface .v658VerdictMetrics i em,.aurynStockEvidenceSurface .v65FactorGrid i em{display:block;height:100%;background:var(--auryn-good)}.aurynStockEvidenceSurface .v658VerdictMetrics article>span{color:var(--auryn-muted);font-size:9px;line-height:1.4}
    .aurynStockEvidenceSurface .v65FactorGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.aurynStockEvidenceSurface .v65FactorGrid>div{min-width:0;padding:14px;border:1px solid var(--auryn-line);border-radius:11px;background:rgba(255,255,255,.26)}.aurynStockEvidenceSurface .v65FactorGrid small{font-size:8px;color:var(--auryn-subtle);letter-spacing:.08em}.aurynStockEvidenceSurface .v65FactorGrid>div>b{display:block;margin-top:6px;font-size:14px}.aurynStockEvidenceSurface .factorNA{color:var(--auryn-subtle);font-size:9px}
    .aurynStockEvidenceSurface .thesisGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}.aurynStockEvidenceSurface .thesisCard{padding:17px;border:1px solid var(--auryn-line);border-radius:12px;background:rgba(255,255,255,.26)}.aurynStockEvidenceSurface .thesisCard>small{font-size:9px;font-weight:850;letter-spacing:.08em;color:var(--auryn-gold-strong)}.aurynStockEvidenceSurface .thesisCard p{margin:9px 0 0;color:var(--auryn-muted);font-size:10px;line-height:1.5}
    .aurynStockEvidenceSurface .v12Fund,.aurynStockEvidenceSurface .v34InstitutionsPage,.aurynStockEvidenceSurface .v12Technical,.aurynStockEvidenceSurface .gammaPanel{padding:4px 0}.aurynStockEvidenceSurface .fundSignal,.aurynStockEvidenceSurface .osList,.aurynStockEvidenceSurface .v34InstitutionHero,.aurynStockEvidenceSurface .v32Institutional,.aurynStockEvidenceSurface .v12Technical>div,.aurynStockEvidenceSurface .gammaPanel>div{border-color:var(--auryn-line);box-shadow:none}
    @media(max-width:900px){.aurynStockEvidenceSurface .v65FactorGrid{grid-template-columns:repeat(2,1fr)}.aurynStockEvidenceSurface .thesisGrid{grid-template-columns:1fr}.aurynStockEvidenceSurface .v658VerdictSurface{grid-template-columns:1fr}.aurynStockEvidenceSurface .v658VerdictAction{border-left:0;border-top:1px solid var(--auryn-line)}}
    @media(max-width:560px){.aurynHealthGrid,.aurynBriefGrid{grid-template-columns:1fr}.aurynHealthGrid article,.aurynBriefGrid article{border-right:0;border-bottom:1px solid var(--auryn-line)}.aurynHealthGrid article:last-child,.aurynBriefGrid article:last-child{border-bottom:0}.aurynPortfolioHealth>header{grid-template-columns:1fr}.aurynStockEvidenceSurface .v65FactorGrid{grid-template-columns:1fr 1fr}.aurynStockEvidenceSurface .v658VerdictMetrics{grid-template-columns:1fr}.aurynStockEvidenceSurface .v658VerdictMetrics article{border-right:0;border-bottom:1px solid var(--auryn-line)}.aurynStockEvidenceSurface .v658VerdictMetrics article:last-child{border-bottom:0}}
    
    
    /* AURYN V3.4 — interaction polish */
    .aurynHelpMark{width:22px!important;height:22px!important;min-width:22px!important;min-height:22px!important;margin:-5px -4px!important;padding:0!important;border:0!important;border-radius:50%!important;background:transparent!important;color:#8b877f!important;display:inline-grid!important;place-items:center!important;opacity:.78!important;vertical-align:middle!important}.aurynHelpMark:hover,.aurynHelpMark[aria-expanded="true"]{color:var(--auryn-gold-strong)!important;opacity:1!important;background:#f2eadf!important}.aurynHelpMark svg{width:13px;height:13px}
    .aurynHoldingGroup{border-bottom:1px solid var(--auryn-line)}.aurynHoldingGroup .aurynHoldingRow{border-bottom:0!important}.aurynHoldingGroup.active{background:rgba(184,139,73,.035)}
    .aurynHoldingEditRow{display:grid;grid-template-columns:minmax(150px,.65fr) minmax(160px,1fr) minmax(160px,1fr) auto;gap:12px;align-items:end;padding:14px 12px 18px 34px;border-top:1px dashed #ded2c0;background:#faf7f1}.aurynHoldingEditRow>div:first-child{align-self:center}.aurynHoldingEditRow small,.aurynDeleteConfirm small{display:block;color:var(--auryn-gold-strong);font-size:8px;font-weight:850;letter-spacing:.13em}.aurynHoldingEditRow label{display:grid;gap:5px}.aurynHoldingEditRow label span{color:var(--auryn-muted);font-size:9px;font-weight:700}.aurynHoldingEditRow input{width:100%;height:42px;border:1px solid #d8cbb8;border-radius:9px;background:#fff;padding:0 12px;font:inherit}.aurynHoldingEditRow input:focus{outline:2px solid rgba(184,139,73,.18);border-color:var(--auryn-gold)}
    .aurynInlineActions{display:flex;gap:7px;align-items:center}.aurynInlineActions button{height:42px;border:1px solid #d8cbb8;border-radius:9px;background:#fff;padding:0 13px;display:inline-flex;align-items:center;justify-content:center;gap:6px;font-size:11px;font-weight:800}.aurynInlineActions button.primary{background:var(--auryn-ink);border-color:var(--auryn-ink);color:#fff}.aurynInlineActions button.danger{background:#8f332d;border-color:#8f332d;color:#fff}
    .aurynDeleteConfirm{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:14px 12px 16px 34px;border-top:1px dashed #e3c9c5;background:#fff7f5}.aurynDeleteConfirm b{display:block;margin:3px 0;font-size:12px}.aurynDeleteConfirm span{color:var(--auryn-muted);font-size:10px}
    
    /* Trading Lab — AURYN product-native, not legacy dashboard cards */
    .aurynLabPage{width:min(1180px,100%);margin:0 auto;padding:18px 0 42px;color:var(--auryn-text)}
    .aurynLabHero{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:28px;align-items:start;padding:26px 0 30px;border-bottom:1px solid var(--auryn-line)}.aurynLabHero h1{max-width:800px;margin:7px 0 10px;font:600 clamp(42px,5.5vw,66px)/.98 Georgia,serif;letter-spacing:-.045em}.aurynLabHero p{max-width:720px;margin:0;color:var(--auryn-muted);font-size:13px;line-height:1.6}.aurynLabPaperBadge{display:inline-flex;align-items:center;gap:7px;margin-top:8px;padding:9px 12px;border:1px solid #cfe6da;border-radius:99px;color:var(--auryn-good);font-size:10px;font-weight:850;letter-spacing:.12em;background:#edf8f2}
    .aurynLabStatus{margin:26px 0 0;padding:28px 30px;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:30px;align-items:center;border-radius:18px;background:var(--auryn-ink);color:#f6eee1}.aurynLabStatus small{color:#a49a8c;font-size:9px;font-weight:850;letter-spacing:.15em}.aurynLabStatus h2{margin:7px 0 6px;font:600 27px Georgia,serif}.aurynLabStatus p{max-width:760px;margin:0;color:#a9a095;font-size:11px;line-height:1.55}.aurynLabRunButton{height:44px;padding:0 17px;border:0;border-radius:10px;background:#f3e8d6;color:#1b1712;display:inline-flex;align-items:center;gap:8px;font-weight:850}.aurynLabRunButton:disabled{opacity:.55}.aurynLabRunMessage{margin-top:10px;padding:11px 14px;border-left:3px solid var(--auryn-gold);background:#f4eee4;color:var(--auryn-muted);font-size:11px}
    .aurynLabPath,.aurynLabActivity,.aurynLabDetails{margin-top:18px;padding:24px 0;border-top:1px solid var(--auryn-line)}.aurynLabSectionHead{display:flex;justify-content:space-between;gap:24px;align-items:flex-end;margin-bottom:16px}.aurynLabSectionHead small{color:var(--auryn-gold-strong);font-size:9px;font-weight:850;letter-spacing:.13em}.aurynLabSectionHead h2{margin:5px 0 0;font:600 29px Georgia,serif}.aurynLabSectionHead>span{max-width:520px;color:var(--auryn-subtle);font-size:10px;line-height:1.45;text-align:right}
    .aurynLabFunnel{display:grid;grid-template-columns:repeat(5,1fr);border:1px solid var(--auryn-line);border-radius:14px;overflow:hidden}.aurynLabFunnel article{min-width:0;padding:18px;border-right:1px solid var(--auryn-line);background:rgba(255,255,255,.3)}.aurynLabFunnel article:last-child{border-right:0}.aurynLabFunnel small{display:block;color:var(--auryn-subtle);font-size:8px;font-weight:800;letter-spacing:.08em}.aurynLabFunnel b{display:block;margin:8px 0 3px;font:600 28px Georgia,serif}.aurynLabFunnel span{color:var(--auryn-muted);font-size:9px;line-height:1.4}.aurynLabFunnel article.good b{color:var(--auryn-good)}.aurynLabFunnel article.mid b{color:var(--auryn-gold-strong)}
    .aurynLabResult{margin-top:12px}.aurynLabResult article{display:flex;gap:14px;align-items:baseline;padding:13px 0;border-bottom:1px solid var(--auryn-line)}.aurynLabResult small{color:var(--auryn-subtle);font-size:9px}.aurynLabResult b{font:600 22px Georgia,serif}.aurynLabResult span{color:var(--auryn-muted);font-size:10px}
    .aurynLabDecisionList{border-top:1px solid var(--auryn-line)}.aurynLabDecisionList article{display:grid;grid-template-columns:150px 120px minmax(0,1fr) auto;gap:16px;align-items:start;padding:16px 0;border-bottom:1px solid var(--auryn-line)}.aurynLabDecisionList article>div b{display:block;font-size:13px}.aurynLabDecisionList article>div span,.aurynLabDecisionList article>strong{font-size:10px}.aurynLabDecisionList article>p{margin:0;color:var(--auryn-muted);font-size:10px;line-height:1.5}.aurynLabWhyLabel{display:block;margin-bottom:3px;color:var(--auryn-text);font-size:8px;letter-spacing:.08em}.aurynLabTrigger{grid-column:3;display:grid;color:var(--auryn-muted);font-size:9px}.aurynLabTrigger b{color:var(--auryn-text)}.aurynLabDecisionList article>em{font-style:normal;font-weight:800}
    .aurynLabEmptyAction{display:flex;align-items:center;gap:12px;padding:18px 0;color:var(--auryn-muted)}.aurynLabEmptyAction b{color:var(--auryn-text)}.aurynLabEmptyAction span{font-size:10px}.aurynLabEmpty{padding:24px 0;color:var(--auryn-muted)}
    .aurynLabDetails{padding:0}.aurynLabDetails summary{list-style:none;cursor:pointer;padding:18px 0;font-size:11px;font-weight:850}.aurynLabDetails summary::-webkit-details-marker{display:none}.aurynLabDetailsBody{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--auryn-line)}.aurynLabDetailsBody>div{padding:16px;border-right:1px solid var(--auryn-line)}.aurynLabDetailsBody>div:last-child{border-right:0}.aurynLabDetailsBody b,.aurynLabDetailsBody span,.aurynLabDetailsBody small{display:block}.aurynLabDetailsBody b{font-size:10px}.aurynLabDetailsBody span{margin:6px 0;color:var(--auryn-text);font-size:11px}.aurynLabDetailsBody small{color:var(--auryn-muted);font-size:9px;line-height:1.4}
    @media(max-width:900px){.aurynHoldingEditRow{grid-template-columns:1fr 1fr}.aurynHoldingEditRow>div:first-child,.aurynHoldingEditRow .aurynInlineActions{grid-column:1/-1}.aurynLabFunnel{grid-template-columns:repeat(2,1fr)}.aurynLabFunnel article{border-bottom:1px solid var(--auryn-line)}.aurynLabFunnel article:nth-child(even){border-right:0}.aurynLabDetailsBody{grid-template-columns:1fr 1fr}.aurynLabDetailsBody>div:nth-child(even){border-right:0}.aurynLabDecisionList article{grid-template-columns:110px 100px minmax(0,1fr)}}
    @media(max-width:560px){.aurynHoldingEditRow{grid-template-columns:1fr;padding:14px}.aurynHoldingEditRow>div:first-child,.aurynHoldingEditRow .aurynInlineActions{grid-column:auto}.aurynDeleteConfirm{align-items:flex-start;flex-direction:column;padding:14px}.aurynLabHero{grid-template-columns:1fr;padding-top:12px}.aurynLabHero h1{font-size:42px}.aurynLabStatus{grid-template-columns:1fr;padding:22px}.aurynLabRunButton{width:100%;justify-content:center}.aurynLabSectionHead{align-items:flex-start;flex-direction:column;gap:5px}.aurynLabSectionHead>span{text-align:left}.aurynLabFunnel{grid-template-columns:1fr}.aurynLabFunnel article{border-right:0}.aurynLabDecisionList article{grid-template-columns:1fr auto}.aurynLabDecisionList article>p,.aurynLabTrigger{grid-column:1/-1}.aurynLabDetailsBody{grid-template-columns:1fr}.aurynLabDetailsBody>div{border-right:0;border-bottom:1px solid var(--auryn-line)}}
    
    
    /* AURYN V3.5 — MOBILE-FIRST RELEASE. Screenshot-driven overrides. */
    @media(max-width:760px){
     /* iPhone shell: do not let content or browser chrome visually collide with product header */
     .aurynHeader{height:calc(56px + env(safe-area-inset-top));padding:env(safe-area-inset-top) 16px 0;grid-template-columns:minmax(0,1fr) auto}
     .aurynHeader .aurynBrand{gap:8px;min-width:0}.aurynHeader .aurynSigil{width:24px;height:24px}.aurynHeader .aurynWord{font-size:19px;letter-spacing:.12em;white-space:nowrap}
     .aurynHeaderRight{gap:0}.aurynAccount>button{width:36px;height:36px}.aurynAppMain{padding:16px 14px calc(76px + env(safe-area-inset-bottom))}
     .aurynBottomNav{min-height:62px;padding:5px 8px calc(5px + env(safe-area-inset-bottom));grid-template-columns:repeat(4,minmax(0,1fr))}
     .aurynBottomNav a{min-height:48px;gap:2px;font-size:9px}.aurynBottomNav a svg{width:19px;height:19px}.aurynBottomNav a.on{background:#2b2720}
    
     /* Research landing: mobile typography with usable density */
     .aurynResearchHero{padding:30px 0 28px}.aurynResearchHero .aurynEyebrow{text-align:left;font-size:9px}
     .aurynResearchHero h1{font-size:clamp(43px,13vw,57px);line-height:.96;margin:12px 0 18px}.aurynResearchHero>p{font-size:15px;line-height:1.55;margin-bottom:22px}
     .aurynSearch.large form{height:54px}.aurynEvidenceRail{grid-template-columns:1fr 1fr}.aurynEvidenceRail>span{padding:15px 8px}.aurynEvidenceRail b{font-size:14px}.aurynEvidenceRail small{font-size:9px}
     .aurynResearchGuide{padding:38px 0}.aurynResearchGuide h2{font-size:34px}
    
     /* Holdings: information-first card rows. Quantity and cost basis are no longer discarded on mobile. */
     .holdingsIntelHead{align-items:end!important}.holdingsIntelHead h2{font-size:42px!important;line-height:1!important}.holdingsIntelHead>span{font-size:11px!important}
     .aurynHoldingRow{grid-template-columns:minmax(0,1fr) auto!important;gap:10px 14px!important;padding:17px 4px!important;align-items:start!important}
     .aurynHoldingName{grid-column:1;grid-row:1}.aurynHoldingName>div>b{font-size:14px!important}.aurynHoldingName>div>span{font-size:10px!important}
     .aurynHoldingMetric{display:none!important}.aurynHoldingMetric:nth-of-type(3){display:grid!important;grid-column:2;grid-row:1;text-align:right;min-width:0}.aurynHoldingMetric:nth-of-type(3) small{font-size:7px!important}.aurynHoldingMetric:nth-of-type(3) b{max-width:150px;font-size:12px!important;line-height:1.15;white-space:normal}
     .aurynHoldingFacts{grid-column:1/-1;grid-row:2;display:flex!important;gap:18px;padding-left:28px}.aurynHoldingFacts span{display:grid;gap:2px}.aurynHoldingFacts small{font-size:7px;letter-spacing:.1em;color:var(--auryn-subtle)}.aurynHoldingFacts b{font-size:11px;font-weight:750}
     .aurynHoldingActions{grid-column:1/-1!important;grid-row:3;display:flex!important;justify-content:flex-end!important;gap:6px!important}.aurynHoldingActions a,.aurynHoldingActions button{width:36px!important;height:36px!important;border-radius:9px!important}.aurynHoldingActions svg{width:15px;height:15px}
     .aurynHoldingEditRow{grid-template-columns:1fr 1fr!important;padding:14px!important}.aurynHoldingEditRow>div:first-child,.aurynHoldingEditRow .aurynInlineActions{grid-column:1/-1!important}
     .aurynDeleteConfirm{padding:14px!important}
    
     /* Mobile thesis: compact hierarchy, no giant desktop card stacked into a phone. */
     .aurynEvidenceNav{margin:0 -14px;padding:3px 14px 8px;gap:2px}.aurynEvidenceNav button{padding:8px 10px;font-size:11px}
     .aurynStockEvidenceSurface .v65Thesis{gap:10px}
     .aurynStockEvidenceSurface .v658VerdictSurface{border-radius:14px}
     .aurynStockEvidenceSurface .v658VerdictLead{padding:18px 16px!important}
     .aurynStockEvidenceSurface .v658VerdictLead>small,.aurynStockEvidenceSurface .v658VerdictAction>small{font-size:8px}
     .aurynStockEvidenceSurface .v658VerdictHeadline{margin:7px 0!important;gap:8px!important;align-items:center!important}
     .aurynStockEvidenceSurface .v658VerdictHeadline h3{font-size:31px!important;line-height:1!important}
     .aurynStockEvidenceSurface .v658VerdictHeadline span{font-size:10px!important;padding:4px 7px!important}
     .aurynStockEvidenceSurface .v658VerdictLead>p{font-size:11px!important;line-height:1.48!important}
     .aurynStockEvidenceSurface .v658VerdictAction{padding:16px!important}.aurynStockEvidenceSurface .v658VerdictAction>b{font-size:24px!important;margin:5px 0 2px!important}.aurynStockEvidenceSurface .v658VerdictAction>p{margin:8px 0 0!important}
     .aurynStockEvidenceSurface .v658VerdictMetrics{grid-template-columns:1fr!important}
     .aurynStockEvidenceSurface .v658VerdictMetrics article{padding:12px 14px!important;border-right:0!important;border-bottom:1px solid var(--auryn-line)}
     .aurynStockEvidenceSurface .v658VerdictMetrics article:last-child{border-bottom:0}.aurynStockEvidenceSurface .v658VerdictMetrics article>span{font-size:9px!important}
     .aurynStockEvidenceSurface .v65FactorGrid{grid-template-columns:1fr!important;gap:7px!important}.aurynStockEvidenceSurface .v65FactorGrid>div{padding:12px!important}
     .aurynStockEvidenceSurface .thesisGrid{grid-template-columns:1fr!important}
     .aurynHelpMark{width:20px!important;height:20px!important;min-width:20px!important;min-height:20px!important;margin:-4px -3px!important}.aurynHelpMark svg{width:12px!important;height:12px!important}
    }
    @media(max-width:390px){
     .aurynAppMain{padding-left:12px;padding-right:12px}.aurynHeader{padding-left:12px;padding-right:12px}
     .aurynResearchHero h1{font-size:43px}.aurynHoldingMetric:nth-of-type(3) b{max-width:132px;font-size:11px!important}
     .aurynBottomNav a{font-size:8px}
    }
    
    /* AURYN V3.6 — stock intelligence strip readability / quote integrity */
    .aurynIntegrityAlert{display:grid;grid-template-columns:max-content minmax(0,1fr);align-items:start;column-gap:12px;row-gap:2px;margin:12px 0 16px;padding:11px 14px;border:1px solid #ddcdb6;border-radius:12px;background:#fbf5ea;color:#55483a;font-size:11px;line-height:1.45}
    .aurynIntegrityAlert b{font-size:10px;line-height:1.45;white-space:nowrap;color:#6f532f}.aurynIntegrityAlert span{min-width:0;color:#766c60}
    .v65IntelStrip{display:grid;grid-template-columns:minmax(280px,1.7fr) minmax(300px,1.05fr) minmax(250px,.9fr) minmax(170px,.55fr);margin:22px 0 0;border:1px solid var(--auryn-line);border-radius:15px;overflow:hidden;background:rgba(255,255,255,.35)}
    .v65IntelStrip>div{min-width:0;padding:18px 20px;border-right:1px solid var(--auryn-line)}.v65IntelStrip small{display:block;margin:0 0 8px;color:var(--auryn-subtle);font-size:8px;font-weight:850;letter-spacing:.13em;line-height:1.2}.v65IntelStrip b{display:block;margin:0;color:var(--auryn-text);font-size:15px;line-height:1.38;overflow-wrap:anywhere}.v65IntelStrip span{display:block;margin-top:5px;color:var(--auryn-muted);font-size:10px;line-height:1.45}.v65IntelStrip p{margin:6px 0 0;color:var(--auryn-muted);font-size:10px;line-height:1.45}.v65IntelStrip .intelLead>div{display:flex;align-items:baseline;gap:8px}.v65IntelStrip .intelLead>div b{font-size:24px}.v65IntelStrip .intelLead>div span{margin:0;font-weight:800}.v65IntelStrip button{min-width:0;border:0;background:#103f2d;color:#fff;padding:18px;font:800 13px/1.25 ui-sans-serif,system-ui;white-space:normal;text-align:center;cursor:pointer}.v65IntelStrip button:hover{background:#0b3526}.aurynIntelTrigger b{font-size:14px}.aurynIntelCoverage b{font-size:17px}
    @media(max-width:980px){.v65IntelStrip{grid-template-columns:1fr 1fr}.v65IntelStrip>div:nth-child(2){border-right:0}.v65IntelStrip button{min-height:58px}.v65IntelStrip .intelLead,.v65IntelStrip .aurynIntelTrigger{border-bottom:1px solid var(--auryn-line)}}
    @media(max-width:760px){.aurynIntegrityAlert{grid-template-columns:1fr;gap:3px;margin:9px 0 12px;padding:10px 12px}.aurynIntegrityAlert b{white-space:normal}.v65IntelStrip{display:grid;grid-template-columns:1fr;margin:15px 0 0;border-radius:13px}.v65IntelStrip>div{padding:14px 15px;border-right:0;border-bottom:1px solid var(--auryn-line)}.v65IntelStrip small{margin-bottom:5px}.v65IntelStrip b{font-size:13px;line-height:1.4}.v65IntelStrip .intelLead>div b{font-size:21px}.v65IntelStrip .aurynIntelCoverage b{font-size:15px}.v65IntelStrip button{min-height:48px;padding:13px 15px;font-size:12px}}
    
    
    /* =========================================================
       AURYN V3.7 — release cleanup, isolated from legacy V65 CSS
       ========================================================= */
    
    /* Header search */
    .aurynSearch.compact form{grid-template-columns:auto minmax(0,1fr);padding-right:12px}
    
    /* Ownership control */
    .aurynOwnershipBar{display:flex;align-items:center;justify-content:space-between;gap:14px;padding:10px 2px;border-bottom:1px solid var(--auryn-line);color:var(--auryn-muted);font-size:11px}
    .aurynOwnershipBar>div{display:flex;align-items:center;gap:7px}.aurynOwnershipBar button{border:1px solid var(--auryn-line);background:transparent;border-radius:9px;padding:8px 10px;color:var(--auryn-text);font-size:10px;font-weight:800}.aurynOwnershipBar button.on{background:#ece5d9;border-color:#d2c4af}
    
    /* Stock intelligence strip */
    .aurynIntelStrip{display:grid;grid-template-columns:minmax(260px,1.6fr) minmax(260px,1fr) minmax(220px,.85fr) minmax(150px,.52fr);margin-top:18px;border:1px solid var(--auryn-line);border-radius:14px;overflow:hidden;background:rgba(255,255,255,.35)}
    .aurynIntelStrip>div{min-width:0;padding:16px 18px;border-right:1px solid var(--auryn-line)}.aurynIntelStrip small{display:block;margin-bottom:6px;color:var(--auryn-subtle);font-size:8px;font-weight:850;letter-spacing:.12em}.aurynIntelStrip b{display:block;color:var(--auryn-text);font-size:14px;line-height:1.42;overflow-wrap:anywhere}.aurynIntelStrip span,.aurynIntelStrip p{color:var(--auryn-muted);font-size:9px;line-height:1.45}.aurynIntelStrip p{margin:5px 0 0}.aurynIntelLead>div{display:flex;align-items:baseline;gap:7px}.aurynIntelLead>div b{font-size:23px}.aurynIntelLead>div span{font-weight:800}.aurynIntelStrip button{border:0;background:var(--auryn-ink);color:#fff;padding:14px;font-size:11px;font-weight:850;line-height:1.3}
    
    /* Thesis — entirely new class system */
    .aurynStockResearch{min-width:0}.aurynThesis{width:min(1120px,100%);margin:0 auto;display:grid;gap:12px}
    .aurynThesisVerdict{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(240px,.55fr);border:1px solid var(--auryn-line);border-radius:18px;overflow:hidden;background:rgba(255,255,255,.38)}
    .aurynThesisLead{padding:24px 26px}.aurynThesisHeadline{display:flex;align-items:center;gap:10px;margin:8px 0}.aurynThesisHeadline h2{margin:0;font:600 38px/1 Georgia,serif;letter-spacing:-.03em}.aurynThesisHeadline>span{padding:5px 8px;border-radius:8px;background:#ece5d9;color:var(--auryn-muted);font-size:11px;font-weight:850}.aurynThesisLead>p{margin:0;max-width:690px;color:var(--auryn-muted);font-size:12px;line-height:1.55}
    .aurynThesisAction{padding:24px;border-left:1px solid var(--auryn-line);display:grid;align-content:center}.aurynThesisAction>b{margin:7px 0 2px;font:600 28px Georgia,serif}.aurynThesisAction>span{font-size:10px;color:var(--auryn-muted)}.aurynThesisAction>p{margin:8px 0 0;color:var(--auryn-subtle);font-size:9px;line-height:1.45}
    .aurynThesisScoreRail{grid-column:1/-1;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--auryn-line)}.aurynThesisScoreRail article{padding:14px 16px;border-right:1px solid var(--auryn-line);min-width:0}.aurynThesisScoreRail article:last-child{border-right:0}.aurynThesisScoreRail article>div{display:flex;justify-content:space-between;gap:10px;align-items:center}.aurynThesisScoreRail article>div>span{display:flex;align-items:center;gap:4px;color:var(--auryn-subtle);font-size:8px;font-weight:850;text-transform:uppercase;letter-spacing:.08em}.aurynThesisScoreRail article>div>b{font-size:13px}.aurynThesisScoreRail i,.aurynThesisFactors i{display:block;height:4px;margin:9px 0 6px;background:#e6e0d6;border-radius:99px;overflow:hidden}.aurynThesisScoreRail i em,.aurynThesisFactors i em{display:block;height:100%;background:var(--auryn-good);border-radius:99px}.aurynThesisScoreRail small{display:block;color:var(--auryn-muted);font-size:9px;line-height:1.4}
    .aurynThesisFactors{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.aurynThesisFactors article{min-width:0;padding:12px 13px;border:1px solid var(--auryn-line);border-radius:11px;background:rgba(255,255,255,.28)}.aurynThesisFactors article>div{display:flex;justify-content:space-between;gap:8px;align-items:center}.aurynThesisFactors article>div>span{display:flex;align-items:center;gap:4px;color:var(--auryn-subtle);font-size:8px;font-weight:800;text-transform:uppercase}.aurynThesisFactors article>div>b{font-size:12px}.aurynThesisFactors article.risk i em{background:var(--auryn-bad)}
    .aurynThesisEvidence{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.aurynThesisEvidence article{padding:14px 15px;border:1px solid var(--auryn-line);border-radius:11px;background:rgba(255,255,255,.25)}.aurynThesisEvidence article>span{display:block;margin-bottom:7px;color:var(--auryn-gold-strong);font-size:8px;font-weight:850;text-transform:uppercase;letter-spacing:.08em}.aurynThesisEvidence p{margin:6px 0;color:var(--auryn-muted);font-size:9px;line-height:1.48}
    
    /* Top portfolio graph */
    .aurynPortfolioComposition{padding:22px 0;border-bottom:1px solid var(--auryn-line)}.aurynPortfolioComposition>header{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:16px}.aurynPortfolioComposition>header small{color:var(--auryn-gold-strong);font-size:8px;font-weight:850;letter-spacing:.13em}.aurynPortfolioComposition>header h2{margin:4px 0 0;font:600 25px Georgia,serif}
    .aurynCompositionBody{display:grid;grid-template-columns:150px 190px minmax(0,1fr);gap:24px;align-items:center}.aurynDonut{width:136px;height:136px;border-radius:50%;display:grid;place-items:center;position:relative}.aurynDonut:after{content:"";position:absolute;inset:24px;border-radius:50%;background:var(--auryn-canvas)}.aurynDonut>div{position:relative;z-index:1;text-align:center}.aurynDonut b{display:block;font:600 17px Georgia,serif}.aurynDonut span{color:var(--auryn-muted);font-size:8px}
    .aurynAllocationLegend{display:grid;gap:9px}.aurynAllocationLegend>span{display:grid;grid-template-columns:10px 1fr auto;gap:8px;align-items:center}.aurynAllocationLegend i{width:8px;height:8px;border-radius:50%}.aurynAllocationLegend i.equity{background:#2f6b56}.aurynAllocationLegend i.crypto{background:#b88b49}.aurynAllocationLegend i.cash{background:#d8d1c4}.aurynAllocationLegend b{font-size:11px}.aurynAllocationLegend em{font-style:normal;color:var(--auryn-muted);font-size:10px}
    .aurynConcentrationBars{display:grid;gap:9px}.aurynConcentrationBars article>div{display:flex;justify-content:space-between;gap:12px;font-size:9px}.aurynConcentrationBars article>div span{color:var(--auryn-muted)}.aurynConcentrationBars article i{display:block;height:5px;margin-top:4px;background:#e5ded3;border-radius:99px;overflow:hidden}.aurynConcentrationBars article i em{display:block;height:100%;background:#7c6b55;border-radius:99px}.aurynConcentrationBars p{margin:5px 0 0;color:var(--auryn-muted);font-size:9px;line-height:1.45}.aurynConcentrationBars p strong{color:var(--auryn-text)}
    
    /* Holdings — compact, clickable, no redundant arrow */
    .aurynHoldingsSection{padding:20px 0 8px;border-top:1px solid var(--auryn-line)}.aurynHoldingsHead{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:10px}.aurynHoldingsHead h2{margin:4px 0 0;font:600 31px Georgia,serif}.aurynHoldingsHead>span{color:var(--auryn-muted);font-size:10px}
    .aurynPositionList{border-top:1px solid var(--auryn-line)}.aurynPositionGroup{border-bottom:1px solid var(--auryn-line)}.aurynPositionGroup.active{background:rgba(184,139,73,.035)}
    .aurynPositionRow{display:grid;grid-template-columns:minmax(150px,1.15fr) repeat(5,minmax(88px,.58fr)) auto;gap:12px;align-items:center;padding:13px 3px;min-width:0}.aurynPositionRow.clickable{cursor:pointer}.aurynPositionRow.clickable:hover{background:rgba(184,139,73,.045)}.aurynPositionRow.clickable:focus-visible{outline:2px solid rgba(184,139,73,.35);outline-offset:2px}
    .aurynPositionName{display:flex;align-items:center;gap:9px;min-width:0}.aurynPositionName>div{min-width:0}.aurynPositionName b{display:block;font-size:13px}.aurynPositionName span{display:block;color:var(--auryn-muted);font-size:9px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.aurynPositionCell small{display:block;color:var(--auryn-subtle);font-size:7px;letter-spacing:.09em}.aurynPositionCell b{display:block;margin-top:3px;font-size:11px;white-space:nowrap}.aurynPositionCall b{white-space:normal;line-height:1.2}
    .aurynPositionActions{display:flex;gap:5px}.aurynPositionActions button{width:30px;height:30px;border:1px solid var(--auryn-line);background:transparent;border-radius:8px;display:grid;place-items:center;color:var(--auryn-muted)}.aurynPositionActions button:hover{background:#f0e9de;color:var(--auryn-text)}
    .aurynPositionEdit{display:grid;grid-template-columns:minmax(120px,.7fr) minmax(150px,1fr) minmax(150px,1fr) auto;gap:10px;align-items:end;padding:13px 12px;background:#faf7f1;border-top:1px dashed #ddd0bd}.aurynPositionEdit small,.aurynPositionDeleteConfirm small{display:block;color:var(--auryn-gold-strong);font-size:8px;font-weight:850;letter-spacing:.12em}.aurynPositionEdit label{display:grid;gap:4px}.aurynPositionEdit label span{font-size:8px;color:var(--auryn-muted)}.aurynPositionEdit input{height:39px;border:1px solid #d7cbb9;border-radius:8px;padding:0 10px;background:#fff}
    .aurynPositionInlineActions{display:flex;gap:6px}.aurynPositionInlineActions button{height:39px;border:1px solid var(--auryn-line);border-radius:8px;background:#fff;padding:0 11px;display:flex;align-items:center;gap:5px;font-size:10px;font-weight:800}.aurynPositionInlineActions .primary{background:var(--auryn-ink);border-color:var(--auryn-ink);color:#fff}.aurynPositionInlineActions .danger{background:#8f332d;border-color:#8f332d;color:#fff}
    .aurynPositionDeleteConfirm{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:12px;background:#fff7f5;border-top:1px dashed #e1c8c2}.aurynPositionDeleteConfirm b{display:block;margin:3px 0;font-size:11px}.aurynPositionDeleteConfirm span{font-size:9px;color:var(--auryn-muted)}
    
    /* Mobile segmented controls — no horizontal scrollbar */
    @media(max-width:760px){
     .aurynVisualModes{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:5px;overflow:visible}.aurynVisualModes button{width:100%;padding:9px 6px;white-space:normal}
     .aurynEvidenceNav{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4px;overflow:visible;margin:0;padding:4px 0 8px}.aurynEvidenceNav button{min-width:0;padding:8px 4px;font-size:9px;white-space:normal}
     .aurynThesis{gap:9px}.aurynThesisVerdict{grid-template-columns:1fr;border-radius:14px}.aurynThesisLead{padding:17px 15px}.aurynThesisHeadline{margin:6px 0}.aurynThesisHeadline h2{font-size:29px}.aurynThesisHeadline>span{font-size:9px}.aurynThesisLead>p{font-size:10px}.aurynThesisAction{padding:14px 15px;border-left:0;border-top:1px solid var(--auryn-line)}.aurynThesisAction>b{font-size:22px}.aurynThesisAction>p{display:none}.aurynThesisScoreRail{grid-template-columns:1fr}.aurynThesisScoreRail article{padding:11px 13px;border-right:0;border-bottom:1px solid var(--auryn-line)}.aurynThesisScoreRail article:last-child{border-bottom:0}.aurynThesisFactors{grid-template-columns:1fr 1fr;gap:6px}.aurynThesisFactors article{padding:10px}.aurynThesisEvidence{grid-template-columns:1fr;gap:6px}.aurynThesisEvidence article{padding:12px}
     .aurynIntelStrip{grid-template-columns:1fr;margin-top:12px}.aurynIntelStrip>div{padding:12px 13px;border-right:0;border-bottom:1px solid var(--auryn-line)}.aurynIntelStrip button{min-height:44px}.aurynIntelLead>div b{font-size:20px}
     .aurynOwnershipBar{padding:8px 0;font-size:9px}.aurynOwnershipBar>div span{display:none}
     .aurynPortfolioComposition{padding:16px 0}.aurynPortfolioComposition>header{margin-bottom:12px}.aurynPortfolioComposition>header h2{font-size:22px}.aurynCompositionBody{grid-template-columns:110px minmax(0,1fr);gap:14px}.aurynDonut{width:104px;height:104px}.aurynDonut:after{inset:19px}.aurynAllocationLegend{gap:6px}.aurynConcentrationBars{grid-column:1/-1}.aurynConcentrationBars p{font-size:9px}
     .aurynHoldingsSection{padding:14px 0 4px}.aurynHoldingsHead{margin-bottom:8px}.aurynHoldingsHead h2{font-size:28px}.aurynPositionRow{grid-template-columns:minmax(0,1fr) auto;gap:8px 12px;padding:12px 2px}.aurynPositionName{grid-column:1}.aurynPositionCall{grid-column:2;grid-row:1;text-align:right;max-width:140px}.aurynPositionActions{grid-column:2;grid-row:2/-1;align-self:end;justify-self:end}.aurynPositionActions button{width:28px;height:28px}.aurynPositionCell:not(.aurynPositionCall){grid-column:auto;display:block}.aurynPositionRow>.aurynPositionCell:nth-of-type(1),.aurynPositionRow>.aurynPositionCell:nth-of-type(2),.aurynPositionRow>.aurynPositionCell:nth-of-type(3),.aurynPositionRow>.aurynPositionCell:nth-of-type(4){font-size:9px}.aurynPositionRow{grid-template-columns:minmax(0,1.2fr) minmax(70px,.7fr) minmax(80px,.8fr)}.aurynPositionName{grid-column:1/-1}.aurynPositionCall{grid-column:1;grid-row:3;text-align:left;max-width:none}.aurynPositionActions{grid-column:3;grid-row:3}.aurynPositionCell{min-width:0}.aurynPositionCell small{font-size:7px}.aurynPositionCell b{font-size:10px;white-space:normal}
     .aurynPositionEdit{grid-template-columns:1fr 1fr;padding:12px}.aurynPositionEdit>div:first-child,.aurynPositionEdit .aurynPositionInlineActions{grid-column:1/-1}.aurynPositionDeleteConfirm{align-items:flex-start;flex-direction:column}
     .aurynAddPanel{margin-top:0;padding-top:12px}
    }
    @media(max-width:420px){
     .aurynEvidenceNav{grid-template-columns:repeat(3,minmax(0,1fr))}
     .aurynThesisFactors{grid-template-columns:1fr}
     .aurynCompositionBody{grid-template-columns:96px minmax(0,1fr)}.aurynDonut{width:92px;height:92px}.aurynDonut:after{inset:17px}.aurynAllocationLegend b{font-size:10px}
     .aurynPositionRow{grid-template-columns:minmax(0,1fr) minmax(72px,.72fr)}.aurynPositionName{grid-column:1/-1}.aurynPositionCell{display:none!important}.aurynPositionRow>.aurynPositionCell:nth-of-type(1),.aurynPositionRow>.aurynPositionCell:nth-of-type(2),.aurynPositionRow>.aurynPositionCell:nth-of-type(3),.aurynPositionCall{display:block!important}.aurynPositionCall{grid-column:1;grid-row:auto}.aurynPositionActions{grid-column:2;grid-row:auto}
    }
    
    
    /* V3.7 holdings layout refinement */
    .aurynPositionRow{grid-template-columns:minmax(150px,1fr) minmax(360px,2.2fr) minmax(110px,.7fr) auto}
    .aurynPositionFacts{display:grid;grid-template-columns:repeat(4,minmax(70px,1fr));gap:10px;min-width:0}.aurynPositionFacts span{min-width:0}.aurynPositionFacts small,.aurynPositionCall small{display:block;color:var(--auryn-subtle);font-size:7px;letter-spacing:.09em}.aurynPositionFacts b,.aurynPositionCall b{display:block;margin-top:3px;font-size:11px;white-space:nowrap}.aurynPositionCall{min-width:0}.aurynPositionCall b{white-space:normal;line-height:1.2}
    .aurynActionPlan{width:min(1120px,100%);margin:0 auto}
    @media(max-width:760px){
     .aurynPositionRow{grid-template-columns:minmax(0,1fr) auto;gap:9px 12px;padding:12px 2px}
     .aurynPositionName{grid-column:1;grid-row:1}.aurynPositionCall{grid-column:2;grid-row:1;text-align:right;max-width:138px}.aurynPositionFacts{grid-column:1/-1;grid-row:2;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;padding-left:27px}.aurynPositionActions{grid-column:1/-1;grid-row:3;justify-self:end}.aurynPositionFacts small{font-size:7px}.aurynPositionFacts b{font-size:10px;white-space:normal}
     .aurynActionPlan{width:100%}
    }
    @media(max-width:420px){
     .aurynPositionFacts{grid-template-columns:1fr 1fr;padding-left:27px;row-gap:7px}.aurynPositionActions{margin-top:-2px}.aurynPositionCall{max-width:122px}
    }
    
    /* V3.7.1 final product polish */
    .aurynMobileSearch{display:none}
    .aurynScoreGuide,.aurynThesisScoreGuide{display:flex;align-items:flex-start;gap:10px;padding:10px 14px;border:1px solid var(--auryn-line);border-radius:11px;background:#faf7f1;color:var(--auryn-muted);font-size:10px;line-height:1.45}
    .aurynScoreGuide b,.aurynThesisScoreGuide b{flex:0 0 auto;color:var(--auryn-text);font-size:10px}
    .aurynEvidencePillars article{min-width:0}.aurynEvidencePillars article b{font-size:18px}.aurynEvidencePillars article span{font-size:10px;line-height:1.4}
    .aurynPositionRow{grid-template-columns:minmax(180px,1fr) minmax(420px,2.2fr) minmax(150px,.8fr) auto;padding:18px 8px;gap:20px}
    .aurynPositionName b{font-size:16px}.aurynPositionName span{font-size:11px;margin-top:3px}
    .aurynPositionFacts{gap:18px}.aurynPositionFacts small,.aurynPositionCall small{font-size:9px}.aurynPositionFacts b,.aurynPositionCall b{font-size:14px;margin-top:5px}
    .aurynPositionActions button{width:36px;height:36px}.aurynPositionRow.clickable{border-radius:12px;transition:background .15s ease,transform .15s ease}.aurynPositionRow.clickable:hover{background:#f7f2e9;transform:translateY(-1px)}
    .aurynIntegrityAlert{display:flex;align-items:flex-start;gap:10px;padding:11px 14px;border:1px solid var(--auryn-line);border-radius:11px;background:#faf7f1}.aurynIntegrityAlert b{white-space:nowrap}.aurynIntegrityAlert span{line-height:1.45}
    .aurynIntelStrip small{font-size:9px}.aurynIntelStrip b{font-size:15px}.aurynIntelStrip span,.aurynIntelStrip p{font-size:10px}.aurynIntelStrip button{font-size:12px}
    .aurynThesisLead>p{font-size:13px}.aurynThesisAction>span{font-size:11px}.aurynThesisAction>p{font-size:10px}.aurynThesisScoreRail article>div>span,.aurynThesisFactors article>div>span{font-size:9px}.aurynThesisScoreRail article>div>b,.aurynThesisFactors article>div>b{font-size:14px}.aurynThesisScoreRail small,.aurynThesisEvidence p{font-size:10px}
    
    @media(max-width:760px){
     .aurynMobileSearch{display:block;position:sticky;top:62px;z-index:110;padding:8px 14px;background:rgba(247,244,238,.96);border-bottom:1px solid var(--auryn-line);backdrop-filter:blur(14px)}
     .aurynMobileSearch .aurynSearch form{min-height:42px;background:#fff}
