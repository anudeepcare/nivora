        business*weights.business+six*weights.six+timing*weights.timing+safe*weights.risk
      )));
    }
    
    type StockWarmCache=ResearchWarmEntry;
    const CORE_ATTEMPTS=1,CORE_TIMEOUT_MS=4500;
    const CACHE_MAX_AGE=15*60*1000;
