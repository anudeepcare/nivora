     const load=useCallback(async()=>{setLoading(true);setError('');try{const s=supabaseBrowser();const {data:{user},error:authError}=await s.auth.getUser();if(authError)throw authError;if(!user){setRows([]);throw Error('Sign in to load your portfolio.');}const {data,error}=await s.from('portfolio_positions').select('*').eq('user_id',user.id).order('updated_at',{ascending:false});if(error)throw error;const positions=(data||[]).map(x=>({...x,asset_type:x.asset_type||'EQUITY'}));setRows(positions);const {data:{session}}=await s.auth.getSession();const h=await fetch('/api/portfolio/pulse',{headers:{Authorization:`Bearer ${session?.access_token||''}`},cache:'no-store'});const j=await h.json();if(h.ok)setHistory(j.items||[]);else{setHistory([]);setNotice('Balance history is unavailable. Current holdings are still shown.')}}catch(e:any){setError(e.message||'Unable to load portfolio.')}finally{setLoading(false)}},[]);
     useEffect(()=>{load();const symbol=new URLSearchParams(window.location.search).get("symbol");if(symbol&&/^[A-Z0-9][A-Z0-9./-]{0,19}$/i.test(symbol)){setDraft({...empty,symbol:symbol.toUpperCase(),asset_type:symbol.includes("/")?"CRYPTO":"EQUITY"});setForm(true)}},[load]);
     const quoteRequests=useMemo(()=>rows.filter(x=>x.asset_type!=='CASH').map(x=>({symbol:x.symbol,assetType:x.asset_type})).sort((a,b)=>a.symbol.localeCompare(b.symbol)),[rows]);
     const {quotes,loading:quotesLoading,refreshing:quotesRefreshing,error:quoteError,lastCheckedAt,now,refresh:refreshQuotes}=usePortfolioQuotes(quoteRequests,rows.length>0);
     const coverage=useMemo(()=>quoteCoverage(rows,quotes,now),[rows,quotes,now]);
     const summary=useMemo(()=>valuationSummary(rows,quotes),[rows,quotes]);
     const assets=useMemo(()=>rows.flatMap<any>(x=>{const value=positionValue(x,quotes[x.symbol]?.market);if(value==null)return [];return x.asset_type==='CASH'?[{assetType:'CASH' as const,currency:'USD',amount:value}]:[{assetType:x.asset_type,symbol:x.symbol,quantity:Number(x.shares),price:quotes[x.symbol].market.displayPrice,avgCost:Number(x.avg_cost),thesisScore:currentResearch(quotes[x.symbol]?.research).thesisScore,action:currentResearch(quotes[x.symbol]?.research).ownerAction||undefined}]}),[rows,quotes]);
     const pulse=useMemo(()=>calculatePortfolioPulse(assets),[assets]);
     const capitalActions=useMemo(()=>{
      if(summary.missing)return [];
      const positions=rows.map(x=>({symbol:x.symbol,value:positionValue(x,quotes[x.symbol]?.market)??0,assetType:x.asset_type,archetype:currentResearch(quotes[x.symbol]?.research).archetype,rawAction:currentResearch(quotes[x.symbol]?.research).ownerAction}));
      const risk=analyzePortfolioRisk(positions.filter(x=>x.assetType!=='CASH').map(x=>({symbol:x.symbol,marketValue:x.value,archetype:x.archetype})));
      return buildPortfolioCioActions({positions,portfolioRisk:risk}).filter(x=>quotes[x.symbol]?.research?.state==='READY');
     },[rows,quotes,summary.missing]);
    
     const points=history.filter(x=>Number.isFinite(Number(x.totalValue))&&Number.isFinite(Date.parse(x.asOf))&&(range==='ALL'||Date.parse(x.asOf)>=Date.now()-Number(range)*86400000)).sort((a,b)=>Date.parse(a.asOf)-Date.parse(b.asOf));
     const values=points.map(x=>Number(x.totalValue)),min=Math.min(...values),max=Math.max(...values),firstTime=points.length?Date.parse(points[0].asOf):0,lastTime=points.length?Date.parse(points[points.length-1].asOf):0,line=points.map(x=>`${(Date.parse(x.asOf)-firstTime)/(lastTime-firstTime||1)*700},${160-(Number(x.totalValue)-min)/(max-min||1)*130}`).join(' ');
     async function save(e:React.FormEvent){e.preventDefault();if(busy)return;setError('');const symbol=draft.symbol.trim().toUpperCase();if(!/^[A-Z0-9][A-Z0-9./-]{0,19}$/.test(symbol)||!validPosition(draft.shares,draft.asset_type==='CASH'?1:draft.avg_cost)){setError('Enter a valid symbol, positive quantity and nonnegative average cost.');return}if(draft.asset_type==='CASH'&&symbol!=='USD'){setError('Cash tracking currently supports USD only; foreign currency needs verified FX valuation.');return}setBusy(true);try{const s=supabaseBrowser();const{data:{user},error}=await s.auth.getUser();if(error)throw error;if(!user)throw Error('Please sign in again.');const normalized=normalizeQuoteSymbol(symbol,draft.asset_type);let payload:any={user_id:user.id,symbol:normalized,asset_type:draft.asset_type,shares:Number(draft.shares),avg_cost:draft.asset_type==='CASH'?1:Number(draft.avg_cost),horizon:draft.horizon,currency:'USD',updated_at:new Date().toISOString()};let id=draft.id;if(!id){const {data:matches,error:readError}=await s.from('portfolio_positions').select('*').eq('user_id',user.id).eq('symbol',normalized);if(readError)throw readError;const existing=(matches||[]).filter(x=>(x.asset_type||'EQUITY')===draft.asset_type);if(existing.length>1)throw Error('Multiple existing lots found. Edit a specific lot to preserve its data.');if(existing.length===1){id=existing[0].id;const merged=mergePositionMath({shares:Number(existing[0].shares),avgCost:Number(existing[0].avg_cost)},{shares:payload.shares,avgCost:payload.avg_cost});payload={...payload,shares:merged.shares,avg_cost:merged.avgCost}}}const result=id?await s.from('portfolio_positions').update(payload).eq('id',id).eq('user_id',user.id):await s.from('portfolio_positions').insert(payload);if(result.error)throw result.error;setForm(false);setDraft(empty);setNotice('Position saved.');await load()}catch(e:any){setError(e.message)}finally{setBusy(false)}}
