    .aurynTabContextState{display:grid;grid-template-columns:auto auto;align-items:baseline;justify-items:end;column-gap:9px;row-gap:3px;min-width:150px}.aurynTabContextState small{grid-column:1;font-size:7px;color:var(--auryn-subtle)}.aurynTabContextState b{grid-column:2;font-size:16px}.aurynTabContextState span{grid-column:1/-1;font-size:9px;font-weight:800}.aurynTabContextState em{grid-column:1/-1;font-style:normal;color:var(--auryn-muted);font-size:9px;font-weight:750}
