    export default function AurynResearchOverviewV2({symbol="Research", company, valuationEvidence, structureCandles=[], structureLoading=false, structureError="", onOpenTechnicals, decision, marketTruth, displayPrice, analystFundamentals, entryQuality, chartRange="3M", chartLoading=false, chartError="", chartCoverage="", onRetryChart, onChartRangeChange, onOpenCatalysts, onOpenRisks, onOpenThesis, onOpenValuation, onAddWatchlist, onTrackPosition, watching=false, candles=[], chartLevels, scenario, executionLevelsAllowed=false, executionIntent="WATCH"}:Props) {
