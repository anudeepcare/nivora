      const yearlyLow=yearlyBars.length?Math.min(...yearlyBars.map((x:any)=>Number(x.low)).filter(Number.isFinite)):null;
      const latestVolumeRaw=yearlyBars.length?Number(yearlyBars.at(-1)?.volume):NaN;
