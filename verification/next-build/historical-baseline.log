     {(tab==='Overview'||tab==='Holdings')&&<HoldingsTable rows={rows} quotes={quotes} now={now} busy={busy} onEdit={row=>{setDraft(row);setForm(true);window.scrollTo({top:0,behavior:'smooth'})}} onRemove={remove}/>}
     {tab==='Overview'&&<details className="pmCard pmPortfolioReview"><summary><div><h2>Balance & portfolio context</h2><span>Recorded history, concentration and research coverage</span></div><ChevronDown size={18}/></summary><div className="pmOverview"><section className="pmCard"><div className="pmCardHead"><div><h2>Portfolio balance</h2><p>Recorded value over time</p></div><div className="pmRanges">{[['30','1M'],['90','3M'],['365','1Y'],['ALL','All']].map(([v,l])=><button key={v} aria-pressed={range===v} onClick={()=>setRange(v)}>{l}</button>)}</div></div>{points.length>=2?<><svg className="pmChart" viewBox="0 0 700 200" role="img" aria-label={`Balance history from ${money(values[0])} to ${money(values[values.length-1])}`}>{[30,95,160].map(y=><line key={y} x1="0" x2="700" y1={y} y2={y} stroke="currentColor" opacity=".08"/>)}<polyline points={line} fill="none" stroke="#3477ff" strokeWidth="3"/></svg><div className="pmChartDates"><span>{new Date(points[0].asOf).toLocaleDateString()}</span><span>{new Date(points[points.length-1].asOf).toLocaleDateString()}</span></div></>:<div className="pmEmpty"><ChartPie size={28}/><p>Not enough recorded snapshots for this period.</p></div>}<button className="pmSecondary" disabled={busy||summary.missing>0} onClick={recordBalance}>{busy?'Recording…':'Record current balance'}</button><p className="pmFootnote">Balance includes deposits, withdrawals and position edits. It is not a cash-flow-adjusted investment return. Historical snapshot pricing has not been revalidated.</p></section><section className="pmCard"><h2>Portfolio perspective</h2><div className="pmInsight"><span>Largest invested position</span><strong>{pulse.investedValue>0?`${pulse.largestPositionPct.toFixed(1)}%`:'—'}</strong><p>Of priced invested capital. Concentration can amplify both gains and losses.</p></div><div className="pmInsight"><span>Evidence coverage</span><strong>{pulse.scorableHoldings} scored equities</strong><p>Open a holding for its long-term thesis, independent valuation and tactical context.</p></div></section></div></details>}
     {tab==='Overview'&&<details className="pmCard pmCapitalPriorities"><summary><div><h2>Capital priorities</h2><span>{capitalActions.length ? `${capitalActions.length} portfolio considerations` : 'Sizing and concentration context'}</span></div><ChevronDown size={18}/></summary><p className="pmFootnote">Portfolio sizing constraints preserve the independent company call. Based on priced holdings and available business classifications; return correlation is not assessed in this view.</p>{capitalActions.length?<div className="pmHoldings">{capitalActions.map(action=><article className="pmHolding" key={action.symbol}><div><Link href={`/stock/${encodeURIComponent(action.symbol)}`}>{action.symbol}</Link><p>{action.reason}</p></div><div><small>Company call</small><b>{action.companyAction.replaceAll('_',' ')}</b></div><div><small>Portfolio action</small><b>{action.portfolioAction.replaceAll('_',' ')}</b></div><div><small>New capital cap</small><b>{action.maxNewPositionPct}%</b></div></article>)}</div>:<p>{summary.missing?'Complete market values are required before sizing priorities can be calculated.':'Refresh holding research to calculate current capital priorities.'}</p>}</details>}
    
    
