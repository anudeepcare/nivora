    const STALE_CACHE_MAX_AGE=7*24*60*60*1000;
    const stockWarmCache=createResearchWarmCache({maxEntries:24,maxAgeMs:STALE_CACHE_MAX_AGE});
    const researchJsonCache=createResearchJsonCache({maxEntries:48});
