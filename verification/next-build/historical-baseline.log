      const fastQuoteProviderFresh=Number.isFinite(fastQuoteProviderAgeMs)&&fastQuoteProviderAgeMs>=0&&fastQuoteProviderAgeMs<15*60*1000&&fastQuote?.freshness!=="STALE";
