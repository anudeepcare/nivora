       <div className="v65ScoreStrip" id="v654-fundamentals">
        <article><small>COMPANY QUALITY <MetricInfo metric="business" score={decision.companyScore} proof={proof.business}/></small><b>{formatScore(decision.companyScore)}/100</b><span>{decision.companyLabel}</span></article>
        <article><small>CURRENT OPPORTUNITY <MetricInfo metric="opportunity" score={decision.opportunityScore} proof={proof.opportunity}/></small><b>{formatScore(decision.opportunityScore)}/100</b><span>{decision.valuationValidity?.fairValueAllowed?decision.valuationLabel:"Valuation not established"}</span></article>
