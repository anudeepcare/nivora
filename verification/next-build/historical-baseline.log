        const cached=researchJsonCache.peek(url,ttlMs);
        setOverviewChartLoading(!cached);setOverviewChartBars(Array.isArray(cached?.candles)?cached.candles:[]);setOverviewChartError("");setOverviewChartCoverage(cached?.coverage||"");
        sharedJson(url,controller.signal,ttlMs)
          .then(j=>{if(!controller.signal.aborted){setOverviewChartBars(Array.isArray(j?.candles)?j.candles:[]);setOverviewChartCoverage([j?.coverage,j?.timeZone].filter(Boolean).join(" · "));}})
          .catch((error:any)=>{if(!controller.signal.aborted){setOverviewChartBars([]);setOverviewChartError(error?.message||"Chart history could not be loaded. Please retry.");}})
          .finally(()=>{if(!controller.signal.aborted)setOverviewChartLoading(false)});
        return()=>controller.abort();
      },[symbol,overviewChartRange,tab,overviewChartRetry]);
      useEffect(()=>{
        if(tab!=="thesis"&&tab!=="technical")return;
        const controller=new AbortController();
