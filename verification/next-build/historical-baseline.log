    .aurynProductFooter .aurynBrand,.aurynProductFooter .aurynWord{color:var(--auryn-footer-ink)!important}.aurynProductFooter .aurynSigil{fill:var(--auryn-accent)!important}.aurynProductFooter .aurynCut{fill:var(--auryn-footer-bg)!important}
    
    .v383TechnicalStateGrid>*{background:var(--auryn-soft-bg)!important}.v34TechnicalScoreGrid>*{background:var(--auryn-soft-bg)!important}.v34IndicatorGrid>div{background:var(--auryn-card-bg)!important}
    
    /* TECHNICALS V9.6.1 — PREMIUM ANALYTICAL COMPOSITION
       Presentation-only refinement. Existing evidence, scores, indicators and logic are untouched. */
    .aurynStockEvidenceSurface>.v12Technical,
    .aurynStockEvidenceSurface>.v26Technical{
      padding:34px!important;
      background:var(--auryn-card-bg)!important;
      border:1px solid var(--auryn-border)!important;
      border-radius:26px!important;
    }
    .v934TechnicalCore{
      margin:0 0 28px!important;
      padding:22px 26px!important;
      background:var(--auryn-soft-bg)!important;
      border:1px solid var(--auryn-border)!important;
      border-radius:18px!important;
    }
    .v34TechnicalHero,.v383TechnicalHero{
      display:grid!important;
      grid-template-columns:minmax(0,1fr) 260px!important;
      align-items:stretch!important;
      margin:0 0 14px!important;
      background:var(--auryn-card-bg)!important;
      border:1px solid var(--auryn-border)!important;
      border-radius:18px!important;
      overflow:hidden!important;
    }
    .v34TechnicalHero>div:first-child,.v383TechnicalHero>div:first-child{
      display:flex!important;
      flex-direction:column!important;
      justify-content:center!important;
      min-height:148px!important;
      padding:24px 28px!important;
    }
    .v34TechnicalHero h3,.v383TechnicalHero h3{
      margin:6px 0 8px!important;
      font-size:25px!important;
      line-height:1.15!important;
    }
    .v34TechnicalHero p,.v383TechnicalHero p{
      max-width:900px!important;
      margin:0!important;
      line-height:1.55!important;
    }
    .v34TechVerdict{
      display:flex!important;
      flex-direction:column!important;
      justify-content:center!important;
      gap:7px!important;
      padding:24px!important;
      background:var(--auryn-soft-bg)!important;
      border-left:1px solid var(--auryn-border)!important;
    }
    .v34TechVerdict b{font-size:32px!important;line-height:1!important}
    .v383TechnicalStateGrid,.v34TechnicalScoreGrid{
      display:grid!important;
      grid-template-columns:repeat(6,minmax(0,1fr))!important;
      gap:10px!important;
      margin:0 0 24px!important;
      padding:0!important;
      background:transparent!important;
      border:0!important;
      overflow:visible!important;
    }
    .v383TechnicalStateGrid>*,.v34TechnicalScoreGrid>*{
