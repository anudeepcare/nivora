    export default function PortfolioPulse({pulse,risk}:{pulse:any;risk?:any}){
     const router=useRouter(); const[period,setPeriod]=useState<(typeof PERIODS)[number]>("1M"),[healthOpen,setHealthOpen]=useState(false),[matrixHover,setMatrixHover]=useState<any>(null);
     const requested=useMemo(()=>calculatePortfolioPeriod(pulse?.history?.points||[],period as PortfolioPeriod),[pulse,period]),available=useMemo(()=>calculatePortfolioPeriod(pulse?.history?.points||[],"ALL" as PortfolioPeriod),[pulse]);
     const r=requested?.status==="ACTUAL"?requested:available?.status==="ACTUAL"?{...available,period,partial:true}:requested,points=Array.isArray(r?.points)?r.points:[],actual=r?.status==="ACTUAL";
     const total=Number(pulse?.totalValue||0),cash=Number(pulse?.cashValue||0),drivers=[...(pulse?.drivers||[])],totalPnl=drivers.reduce((a:number,x:any)=>a+Number(x.pnl||0),0),invested=Math.max(0,total-cash),cost=Math.max(0,invested-totalPnl),positions=drivers.length;
     const history=pulse?.history?.points||[],last=history.at?.(-1),prev=history.length>1?history[history.length-2]:null,todayPnl=last&&prev?Number(last.totalValue||0)-Number(prev.totalValue||0):0,todayPct=prev?.totalValue?todayPnl/Number(prev.totalValue)*100:null;
     const health=Number(pulse?.health?.score||0),largest=Number(pulse?.concentration?.largestPositionPct||0),top3=Number(pulse?.concentration?.top3Pct||0),top5=Number(pulse?.concentration?.top5Pct||0),cashPct=Number(pulse?.allocations?.cashPct||0),cryptoPct=Number(pulse?.allocations?.cryptoPct||0),stockPct=Number(pulse?.allocations?.equityPct||0);
     const actions=[...(pulse?.actions||[])].filter((x:any)=>x.portfolioAction&&x.portfolioAction!=="HOLD"),attention=actions.filter((x:any)=>/AVOID|TRIM|WATCH/i.test(x.portfolioAction)).sort((a:any,b:any)=>Number(b.weightPct||0)-Number(a.weightPct||0)).slice(0,5);
     const gainers=drivers.filter((x:any)=>Number(x.pnl)>0).sort((a:any,b:any)=>Number(b.pnl)-Number(a.pnl)).slice(0,5),losers=drivers.filter((x:any)=>Number(x.pnl)<0).sort((a:any,b:any)=>Number(a.pnl)-Number(b.pnl)).slice(0,5),driverMax=Math.max(1,...drivers.map((x:any)=>Math.abs(Number(x.pnl||0))));
     const actionBySymbol=new Map((pulse?.actions||[]).map((x:any)=>[String(x.symbol),x]));
     const mapRows=drivers.map((x:any)=>{const a:any=actionBySymbol.get(String(x.symbol))||{};const weightPct=Number(a.weightPct||0);return{...x,weightPct,positionValue:total*weightPct/100,aurynAction:String(a.portfolioAction||"HOLD"),returnPct:Number.isFinite(Number(x.returnPct))?Number(x.returnPct):0};});
